{"number":80,"nameUz":"Abasa","nameCyr":"Абаса","nameArabic":"عَبَسَ","nameEnglish":"Abasa","englishNameTranslation":"He frowned","revelation":"Makkiy","ayahCount":42,"ayahs":[{"number":5759,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","translation":{"latin":"Aftini burishtirdi va yuz oʻgirdi.","cyrillic":"Афтини буриштирди ва юз ўгирди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5759.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5759.mp3","juz":30,"page":585,"sajda":false},{"number":5760,"numberInSurah":2,"text":"أَن جَآءَهُ ٱلْأَعْمَىٰ","translation":{"latin":"Koʻzi koʻr kishi huzuriga kelganda.","cyrillic":"Кўзи кўр киши ҳузурига келганда."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5760.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5760.mp3","juz":30,"page":585,"sajda":false},{"number":5761,"numberInSurah":3,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","translation":{"latin":"Qayerdan bilasan, ehtimol, u poklanar.","cyrillic":"Қаердан биласан, эҳтимол, у покланар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5761.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5761.mp3","juz":30,"page":585,"sajda":false},{"number":5762,"numberInSurah":4,"text":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","translation":{"latin":"Yoki nasihat olar va mavʼiza unga manfaat berar.","cyrillic":"Ёки насиҳат олар ва мавъиза унга манфаат берар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5762.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5762.mp3","juz":30,"page":585,"sajda":false},{"number":5763,"numberInSurah":5,"text":"أَمَّا مَنِ ٱسْتَغْنَىٰ","translation":{"latin":"Ammo istigʻno qilganga boʻlsa...","cyrillic":"Аммо истиғно қилганга бўлса..."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5763.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5763.mp3","juz":30,"page":585,"sajda":false},{"number":5764,"numberInSurah":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","translation":{"latin":"Sen u tomonga intilasan.","cyrillic":"Сен у томонга интиласан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5764.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5764.mp3","juz":30,"page":585,"sajda":false},{"number":5765,"numberInSurah":7,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","translation":{"latin":"U poklanmasa, seni hech kim malomat qilmas.","cyrillic":"У покланмаса, сени ҳеч ким маломат қилмас."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5765.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5765.mp3","juz":30,"page":585,"sajda":false},{"number":5766,"numberInSurah":8,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","translation":{"latin":"Ammo huzuringga shoshilib kelgan.","cyrillic":"Аммо ҳузурингга шошилиб келган."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5766.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5766.mp3","juz":30,"page":585,"sajda":false},{"number":5767,"numberInSurah":9,"text":"وَهُوَ يَخْشَىٰ","translation":{"latin":"Va U zotdan qoʻrqqan holda boʻlgandan esa...","cyrillic":"Ва У зотдан қўрққан ҳолда бўлгандан эса..."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5767.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5767.mp3","juz":30,"page":585,"sajda":false},{"number":5768,"numberInSurah":10,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ","translation":{"latin":"Bas, Sen undan mashgʻul boʻlasan.","cyrillic":"Бас, Сен ундан машғул бўласан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5768.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5768.mp3","juz":30,"page":585,"sajda":false},{"number":5769,"numberInSurah":11,"text":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","translation":{"latin":"Yoʻq! Albatta ular (Qurʼon oyatlari) eslatmadir.","cyrillic":"Йўқ! Албатта улар (Қуръон оятлари) эслатмадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5769.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5769.mp3","juz":30,"page":585,"sajda":false},{"number":5770,"numberInSurah":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ","translation":{"latin":"Kim xohlasa, uni eslaydir.","cyrillic":"Ким хоҳласа, уни эслайдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5770.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5770.mp3","juz":30,"page":585,"sajda":false},{"number":5771,"numberInSurah":13,"text":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","translation":{"latin":"Hurmatlangan sahifalardadir.","cyrillic":"Ҳурматланган саҳифалардадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5771.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5771.mp3","juz":30,"page":585,"sajda":false},{"number":5772,"numberInSurah":14,"text":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","translation":{"latin":"Oliy qadardirlar, poklangandirlar.","cyrillic":"Олий қадардирлар, поклангандирлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5772.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5772.mp3","juz":30,"page":585,"sajda":false},{"number":5773,"numberInSurah":15,"text":"بِأَيْدِى سَفَرَةٍۢ","translation":{"latin":"Elchi(farishta)lar qoʻllaridadir.","cyrillic":"Элчи(фаришта)лар қўлларидадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5773.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5773.mp3","juz":30,"page":585,"sajda":false},{"number":5774,"numberInSurah":16,"text":"كِرَامٍۭ بَرَرَةٍۢ","translation":{"latin":"Ular hurmatlangan va oʻta yaxshidirlar.","cyrillic":"Улар ҳурматланган ва ўта яхшидирлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5774.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5774.mp3","juz":30,"page":585,"sajda":false},{"number":5775,"numberInSurah":17,"text":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","translation":{"latin":"Insonga laʼnat boʻlsin, uning kofirligi qandoq shiddatli boʻldi.","cyrillic":"Инсонга лаънат бўлсин, унинг кофирлиги қандоқ шиддатли бўлди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5775.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5775.mp3","juz":30,"page":585,"sajda":false},{"number":5776,"numberInSurah":18,"text":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","translation":{"latin":"Uni qaysi narsadan yaratdi?","cyrillic":"Уни қайси нарсадан яратди?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5776.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5776.mp3","juz":30,"page":585,"sajda":false},{"number":5777,"numberInSurah":19,"text":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","translation":{"latin":"Nutfadan uni yaratdi va uni oʻlchovli qildi.","cyrillic":"Нутфадан уни яратди ва уни ўлчовли қилди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5777.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5777.mp3","juz":30,"page":585,"sajda":false},{"number":5778,"numberInSurah":20,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","translation":{"latin":"Soʻngra, chiqish yoʻlini oson qildi.","cyrillic":"Сўнгра, чиқиш йўлини осон қилди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5778.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5778.mp3","juz":30,"page":585,"sajda":false},{"number":5779,"numberInSurah":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","translation":{"latin":"Soʻngra oʻldirdi va qabrga kirgazdi.","cyrillic":"Сўнгра ўлдирди ва қабрга киргазди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5779.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5779.mp3","juz":30,"page":585,"sajda":false},{"number":5780,"numberInSurah":22,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","translation":{"latin":"Soʻngra (qachon) xohlasa, uni qayta tiriltiradi.","cyrillic":"Сўнгра (қачон) хоҳласа, уни қайта тирилтиради."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5780.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5780.mp3","juz":30,"page":585,"sajda":false},{"number":5781,"numberInSurah":23,"text":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","translation":{"latin":"Yoʻq, undoq emas! U oʻziga U zot qilgan amrni bajarmadi.","cyrillic":"Йўқ, ундоқ эмас! У ўзига У зот қилган амрни бажармади."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5781.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5781.mp3","juz":30,"page":585,"sajda":false},{"number":5782,"numberInSurah":24,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","translation":{"latin":"Inson oʻz taomiga nazar solsin.","cyrillic":"Инсон ўз таомига назар солсин."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5782.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5782.mp3","juz":30,"page":585,"sajda":false},{"number":5783,"numberInSurah":25,"text":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","translation":{"latin":"Albatta, Biz suvni rosa quyib qoʻyibmiz.","cyrillic":"Албатта, Биз сувни роса қуйиб қўйибмиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5783.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5783.mp3","juz":30,"page":585,"sajda":false},{"number":5784,"numberInSurah":26,"text":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","translation":{"latin":"Soʻngra erni oʻziga xos yordik.","cyrillic":"Сўнгра ерни ўзига хос ёрдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5784.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5784.mp3","juz":30,"page":585,"sajda":false},{"number":5785,"numberInSurah":27,"text":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","translation":{"latin":"Biz unda donni.","cyrillic":"Биз унда донни."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5785.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5785.mp3","juz":30,"page":585,"sajda":false},{"number":5786,"numberInSurah":28,"text":"وَعِنَبًۭا وَقَضْبًۭا","translation":{"latin":"Va uzum va koʻklarni.","cyrillic":"Ва узум ва кўкларни."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5786.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5786.mp3","juz":30,"page":585,"sajda":false},{"number":5787,"numberInSurah":29,"text":"وَزَيْتُونًۭا وَنَخْلًۭا","translation":{"latin":"Va zaytun va xurmolarni.","cyrillic":"Ва зайтун ва хурмоларни."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5787.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5787.mp3","juz":30,"page":585,"sajda":false},{"number":5788,"numberInSurah":30,"text":"وَحَدَآئِقَ غُلْبًۭا","translation":{"latin":"Va tigʻiz bogʻlarni.","cyrillic":"Ва тиғиз боғларни."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5788.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5788.mp3","juz":30,"page":585,"sajda":false},{"number":5789,"numberInSurah":31,"text":"وَفَٰكِهَةًۭ وَأَبًّۭا","translation":{"latin":"Va mevalaru oʻt-oʻlanlarni oʻstirib qoʻydik.","cyrillic":"Ва мевалару ўт-ўланларни ўстириб қўйдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5789.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5789.mp3","juz":30,"page":585,"sajda":false},{"number":5790,"numberInSurah":32,"text":"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","translation":{"latin":"Sizlarga va chorvalaringizga manfaat va lazzat boʻlsin, deb.","cyrillic":"Сизларга ва чорваларингизга манфаат ва лаззат бўлсин, деб."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5790.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5790.mp3","juz":30,"page":585,"sajda":false},{"number":5791,"numberInSurah":33,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","translation":{"latin":"Vaqtiki kar qiluvchi ovoz kelsa.","cyrillic":"Вақтики кар қилувчи овоз келса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5791.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5791.mp3","juz":30,"page":585,"sajda":false},{"number":5792,"numberInSurah":34,"text":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","translation":{"latin":"U kunda kishi oʻz aka-ukasidan.","cyrillic":"У кунда киши ўз ака-укасидан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5792.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5792.mp3","juz":30,"page":585,"sajda":false},{"number":5793,"numberInSurah":35,"text":"وَأُمِّهِۦ وَأَبِيهِ","translation":{"latin":"Va onasi va otasidan.","cyrillic":"Ва онаси ва отасидан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5793.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5793.mp3","juz":30,"page":585,"sajda":false},{"number":5794,"numberInSurah":36,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","translation":{"latin":"Va xotini va bola-chaqasidan qochadi.","cyrillic":"Ва хотини ва бола-чақасидан қочади."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5794.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5794.mp3","juz":30,"page":585,"sajda":false},{"number":5795,"numberInSurah":37,"text":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","translation":{"latin":"U kunda ulardan har bir shaxsni ovora qiluvchi oʻz ishi bor.","cyrillic":"У кунда улардан ҳар бир шахсни овора қилувчи ўз иши бор."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5795.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5795.mp3","juz":30,"page":585,"sajda":false},{"number":5796,"numberInSurah":38,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","translation":{"latin":"U kunda porloq chehralar bor.","cyrillic":"У кунда порлоқ чеҳралар бор."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5796.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5796.mp3","juz":30,"page":585,"sajda":false},{"number":5797,"numberInSurah":39,"text":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","translation":{"latin":"Ular kulgu bilan toʻla, etgan xushxabardan xursand.","cyrillic":"Улар кулгу билан тўла, етган хушхабардан хурсанд."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5797.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5797.mp3","juz":30,"page":585,"sajda":false},{"number":5798,"numberInSurah":40,"text":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","translation":{"latin":"U kunda bir chehralar borki, ularni gʻubor bosgan.","cyrillic":"У кунда бир чеҳралар борки, уларни ғубор босган."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5798.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5798.mp3","juz":30,"page":585,"sajda":false},{"number":5799,"numberInSurah":41,"text":"تَرْهَقُهَا قَتَرَةٌ","translation":{"latin":"Ustini zulmat qoplagan.","cyrillic":"Устини зулмат қоплаган."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5799.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5799.mp3","juz":30,"page":585,"sajda":false},{"number":5800,"numberInSurah":42,"text":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","translation":{"latin":"Ular, ana oʻshalar, kofirlar va fojirlardir.","cyrillic":"Улар, ана ўшалар, кофирлар ва фожирлардир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5800.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5800.mp3","juz":30,"page":585,"sajda":false}]}