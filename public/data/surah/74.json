{"number":74,"nameUz":"Muddassir","nameCyr":"Муддассир","nameArabic":"المُدَّثِّرِ","nameEnglish":"Al-Muddaththir","englishNameTranslation":"The Cloaked One","revelation":"Makkiy","ayahCount":56,"ayahs":[{"number":5496,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يَٰٓأَيُّهَا ٱلْمُدَّثِّرُ","translation":{"latin":"Ey, burkanib yotgan!","cyrillic":"Эй, бурканиб ётган!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5496.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5496.mp3","juz":29,"page":575,"sajda":false},{"number":5497,"numberInSurah":2,"text":"قُمْ فَأَنذِرْ","translation":{"latin":"Tur va ogohlantir!","cyrillic":"Тур ва огоҳлантир!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5497.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5497.mp3","juz":29,"page":575,"sajda":false},{"number":5498,"numberInSurah":3,"text":"وَرَبَّكَ فَكَبِّرْ","translation":{"latin":"Va Robbingni ulugʻla!","cyrillic":"Ва Роббингни улуғла!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5498.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5498.mp3","juz":29,"page":575,"sajda":false},{"number":5499,"numberInSurah":4,"text":"وَثِيَابَكَ فَطَهِّرْ","translation":{"latin":"Va kiyimingni pokla!","cyrillic":"Ва кийимингни покла!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5499.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5499.mp3","juz":29,"page":575,"sajda":false},{"number":5500,"numberInSurah":5,"text":"وَٱلرُّجْزَ فَٱهْجُرْ","translation":{"latin":"Va azob(sababchisi)dan chetlan!","cyrillic":"Ва азоб(сабабчиси)дан четлан!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5500.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5500.mp3","juz":29,"page":575,"sajda":false},{"number":5501,"numberInSurah":6,"text":"وَلَا تَمْنُن تَسْتَكْثِرُ","translation":{"latin":"Va koʻp (ish) qilgan boʻlsang ham, minnat qilma.","cyrillic":"Ва кўп (иш) қилган бўлсанг ҳам, миннат қилма."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5501.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5501.mp3","juz":29,"page":575,"sajda":false},{"number":5502,"numberInSurah":7,"text":"وَلِرَبِّكَ فَٱصْبِرْ","translation":{"latin":"Va Robbing uchun sabr qil.","cyrillic":"Ва Роббинг учун сабр қил."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5502.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5502.mp3","juz":29,"page":575,"sajda":false},{"number":5503,"numberInSurah":8,"text":"فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ","translation":{"latin":"Bas, vaqti kelib, dudga puflansa...","cyrillic":"Бас, вақти келиб, дудга пуфланса..."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5503.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5503.mp3","juz":29,"page":575,"sajda":false},{"number":5504,"numberInSurah":9,"text":"فَذَٰلِكَ يَوْمَئِذٍۢ يَوْمٌ عَسِيرٌ","translation":{"latin":"Bas, oʻsha, oʻshal kun qiyin kundir.","cyrillic":"Бас, ўша, ўшал кун қийин кундир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5504.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5504.mp3","juz":29,"page":575,"sajda":false},{"number":5505,"numberInSurah":10,"text":"عَلَى ٱلْكَٰفِرِينَ غَيْرُ يَسِيرٍۢ","translation":{"latin":"U kofirlarga oson emasdir.","cyrillic":"У кофирларга осон эмасдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5505.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5505.mp3","juz":29,"page":575,"sajda":false},{"number":5506,"numberInSurah":11,"text":"ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًۭا","translation":{"latin":"Meni Oʻzim yakka yaratgan kishi bilan qoʻyib qoʻy.","cyrillic":"Мени Ўзим якка яратган киши билан қўйиб қўй."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5506.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5506.mp3","juz":29,"page":575,"sajda":false},{"number":5507,"numberInSurah":12,"text":"وَجَعَلْتُ لَهُۥ مَالًۭا مَّمْدُودًۭا","translation":{"latin":"Va unga koʻplab molu dunyo berib qoʻydim.","cyrillic":"Ва унга кўплаб молу дунё бериб қўйдим."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5507.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5507.mp3","juz":29,"page":575,"sajda":false},{"number":5508,"numberInSurah":13,"text":"وَبَنِينَ شُهُودًۭا","translation":{"latin":"Va hoziru nozir farzandlar ham.","cyrillic":"Ва ҳозиру нозир фарзандлар ҳам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5508.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5508.mp3","juz":29,"page":575,"sajda":false},{"number":5509,"numberInSurah":14,"text":"وَمَهَّدتُّ لَهُۥ تَمْهِيدًۭا","translation":{"latin":"Va unga (hamma narsani) osonlashtirib qoʻydim.","cyrillic":"Ва унга (ҳамма нарсани) осонлаштириб қўйдим."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5509.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5509.mp3","juz":29,"page":575,"sajda":false},{"number":5510,"numberInSurah":15,"text":"ثُمَّ يَطْمَعُ أَنْ أَزِيدَ","translation":{"latin":"Soʻngra, yana ziyoda qilishimni tamaʼ qilur.","cyrillic":"Сўнгра, яна зиёда қилишимни тамаъ қилур."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5510.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5510.mp3","juz":29,"page":575,"sajda":false},{"number":5511,"numberInSurah":16,"text":"كَلَّآ ۖ إِنَّهُۥ كَانَ لِءَايَٰتِنَا عَنِيدًۭا","translation":{"latin":"Yoʻq! Chunki, u Bizning oyatlarimizga sarkash edi.","cyrillic":"Йўқ! Чунки, у Бизнинг оятларимизга саркаш эди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5511.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5511.mp3","juz":29,"page":575,"sajda":false},{"number":5512,"numberInSurah":17,"text":"سَأُرْهِقُهُۥ صَعُودًا","translation":{"latin":"Tezda uni mashaqqatli chiqish-la horitaman.","cyrillic":"Тезда уни машаққатли чиқиш-ла ҳоритаман."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5512.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5512.mp3","juz":29,"page":575,"sajda":false},{"number":5513,"numberInSurah":18,"text":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","translation":{"latin":"Albatta, u tafakkur qildi va chamalab koʻrdi.","cyrillic":"Албатта, у тафаккур қилди ва чамалаб кўрди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5513.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5513.mp3","juz":29,"page":576,"sajda":false},{"number":5514,"numberInSurah":19,"text":"فَقُتِلَ كَيْفَ قَدَّرَ","translation":{"latin":"Laʼnat boʻlsin unga, qandoq ham chamaladi!","cyrillic":"Лаънат бўлсин унга, қандоқ ҳам чамалади!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5514.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5514.mp3","juz":29,"page":576,"sajda":false},{"number":5515,"numberInSurah":20,"text":"ثُمَّ قُتِلَ كَيْفَ قَدَّرَ","translation":{"latin":"Soʻngra yana laʼnat boʻlsin unga, qandoq ham chamaladi.","cyrillic":"Сўнгра яна лаънат бўлсин унга, қандоқ ҳам чамалади."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5515.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5515.mp3","juz":29,"page":576,"sajda":false},{"number":5516,"numberInSurah":21,"text":"ثُمَّ نَظَرَ","translation":{"latin":"Soʻngra nazar soldi.","cyrillic":"Сўнгра назар солди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5516.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5516.mp3","juz":29,"page":576,"sajda":false},{"number":5517,"numberInSurah":22,"text":"ثُمَّ عَبَسَ وَبَسَرَ","translation":{"latin":"Soʻngra yuzini burishtirdi va qavogʻini soldi.","cyrillic":"Сўнгра юзини буриштирди ва қавоғини солди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5517.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5517.mp3","juz":29,"page":576,"sajda":false},{"number":5518,"numberInSurah":23,"text":"ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ","translation":{"latin":"Soʻngra yuz oʻgirdi va takabburlik qildi.","cyrillic":"Сўнгра юз ўгирди ва такаббурлик қилди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5518.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5518.mp3","juz":29,"page":576,"sajda":false},{"number":5519,"numberInSurah":24,"text":"فَقَالَ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ يُؤْثَرُ","translation":{"latin":"Bas, «Bu asar qolgan sehrdan oʻzga hech narsa emas.","cyrillic":"Бас, «Бу асар қолган сеҳрдан ўзга ҳеч нарса эмас."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5519.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5519.mp3","juz":29,"page":576,"sajda":false},{"number":5520,"numberInSurah":25,"text":"إِنْ هَٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ","translation":{"latin":"Bu bashar soʻzidan oʻzga hech narsa emas», dedi.","cyrillic":"Бу башар сўзидан ўзга ҳеч нарса эмас», деди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5520.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5520.mp3","juz":29,"page":576,"sajda":false},{"number":5521,"numberInSurah":26,"text":"سَأُصْلِيهِ سَقَرَ","translation":{"latin":"Tezda uni saqar(doʻzaxi)ga kiriturman.","cyrillic":"Тезда уни сақар(дўзахи)га киритурман."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5521.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5521.mp3","juz":29,"page":576,"sajda":false},{"number":5522,"numberInSurah":27,"text":"وَمَآ أَدْرَىٰكَ مَا سَقَرُ","translation":{"latin":"Va saqar nimaligini senga nima bildirdi?","cyrillic":"Ва сақар нималигини сенга нима билдирди?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5522.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5522.mp3","juz":29,"page":576,"sajda":false},{"number":5523,"numberInSurah":28,"text":"لَا تُبْقِى وَلَا تَذَرُ","translation":{"latin":"U boqiy qoldirmas va tark ham qilmas.","cyrillic":"У боқий қолдирмас ва тарк ҳам қилмас."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5523.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5523.mp3","juz":29,"page":576,"sajda":false},{"number":5524,"numberInSurah":29,"text":"لَوَّاحَةٌۭ لِّلْبَشَرِ","translation":{"latin":"U terini koʻp kuydiruvchidir.","cyrillic":"У терини кўп куйдирувчидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5524.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5524.mp3","juz":29,"page":576,"sajda":false},{"number":5525,"numberInSurah":30,"text":"عَلَيْهَا تِسْعَةَ عَشَرَ","translation":{"latin":"U(saqar)ning ustida oʻn toʻqqizta (farishta) bor.","cyrillic":"У(сақар)нинг устида ўн тўққизта (фаришта) бор."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5525.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5525.mp3","juz":29,"page":576,"sajda":false},{"number":5526,"numberInSurah":31,"text":"وَمَا جَعَلْنَآ أَصْحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةًۭ ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةًۭ لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَٰنًۭا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌۭ وَٱلْكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلًۭا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","translation":{"latin":"Doʻzax sohiblarini farishtalardan qilganimiz va ularning adadi ham faqat kofirlarni sinash uchun. Kitob berilganlar ishonch hosil qilishlari uchun. Va iymonlilarning iymoni ziyoda boʻlishi uchun. Kitob berilganlar va moʻminlar shak-shubha qilmasliklari uchun va qalblarida kasali borlar (munofiqlar) va kofirlar, Alloh bu bilan nima misolni iroda qilmoqchi, deyishlari uchun. Shundoq qilib, Alloh xohlagan kimsani adashtirur va xohlagan kimsani hidoyatga solur. Robbingning askarlarini Oʻzidan boshqa hech kim bilmas. Va u (doʻzax) bashar uchun eslatmadan oʻzga hech narsa emas.","cyrillic":"Дўзах соҳибларини фаришталардан қилганимиз ва уларнинг адади ҳам фақат кофирларни синаш учун. Китоб берилганлар ишонч ҳосил қилишлари учун. Ва иймонлиларнинг иймони зиёда бўлиши учун. Китоб берилганлар ва мўминлар шак-шубҳа қилмасликлари учун ва қалбларида касали борлар (мунофиқлар) ва кофирлар, Аллоҳ бу билан нима мисолни ирода қилмоқчи, дейишлари учун. Шундоқ қилиб, Аллоҳ хоҳлаган кимсани адаштирур ва хоҳлаган кимсани ҳидоятга солур. Роббингнинг аскарларини Ўзидан бошқа ҳеч ким билмас. Ва у (дўзах) башар учун эслатмадан ўзга ҳеч нарса эмас."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5526.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5526.mp3","juz":29,"page":576,"sajda":false},{"number":5527,"numberInSurah":32,"text":"كَلَّا وَٱلْقَمَرِ","translation":{"latin":"Yoʻq! Oy bilan qasam.","cyrillic":"Йўқ! Ой билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5527.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5527.mp3","juz":29,"page":576,"sajda":false},{"number":5528,"numberInSurah":33,"text":"وَٱلَّيْلِ إِذْ أَدْبَرَ","translation":{"latin":"Va chekinayotgan tun bilan qasam.","cyrillic":"Ва чекинаётган тун билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5528.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5528.mp3","juz":29,"page":576,"sajda":false},{"number":5529,"numberInSurah":34,"text":"وَٱلصُّبْحِ إِذَآ أَسْفَرَ","translation":{"latin":"Va yorishayotgan tong bilan qasam.","cyrillic":"Ва ёришаётган тонг билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5529.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5529.mp3","juz":29,"page":576,"sajda":false},{"number":5530,"numberInSurah":35,"text":"إِنَّهَا لَإِحْدَى ٱلْكُبَرِ","translation":{"latin":"Albatta, u(doʻzax) ulkan(azob)larning biridir.","cyrillic":"Албатта, у(дўзах) улкан(азоб)ларнинг биридир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5530.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5530.mp3","juz":29,"page":576,"sajda":false},{"number":5531,"numberInSurah":36,"text":"نَذِيرًۭا لِّلْبَشَرِ","translation":{"latin":"U bashariyat uchun ogohlantiruvchidir.","cyrillic":"У башарият учун огоҳлантирувчидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5531.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5531.mp3","juz":29,"page":576,"sajda":false},{"number":5532,"numberInSurah":37,"text":"لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ","translation":{"latin":"Sizlardan peshqadam boʻlishni yoki ortda qolishni xohlayotgan kimsalar uchundir.","cyrillic":"Сизлардан пешқадам бўлишни ёки ортда қолишни хоҳлаётган кимсалар учундир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5532.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5532.mp3","juz":29,"page":576,"sajda":false},{"number":5533,"numberInSurah":38,"text":"كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ","translation":{"latin":"Har bir shaxs oʻz kasbining garovidir.","cyrillic":"Ҳар бир шахс ўз касбининг гаровидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5533.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5533.mp3","juz":29,"page":576,"sajda":false},{"number":5534,"numberInSurah":39,"text":"إِلَّآ أَصْحَٰبَ ٱلْيَمِينِ","translation":{"latin":"(Bundan) oʻng taraf sohiblari mustasnodir.","cyrillic":"(Бундан) ўнг тараф соҳиблари мустаснодир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5534.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5534.mp3","juz":29,"page":576,"sajda":false},{"number":5535,"numberInSurah":40,"text":"فِى جَنَّٰتٍۢ يَتَسَآءَلُونَ","translation":{"latin":"Ular jannatlarda, soʻraydirlar.","cyrillic":"Улар жаннатларда, сўрайдирлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5535.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5535.mp3","juz":29,"page":576,"sajda":false},{"number":5536,"numberInSurah":41,"text":"عَنِ ٱلْمُجْرِمِينَ","translation":{"latin":"Gunohkorlardan.","cyrillic":"Гуноҳкорлардан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5536.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5536.mp3","juz":29,"page":576,"sajda":false},{"number":5537,"numberInSurah":42,"text":"مَا سَلَكَكُمْ فِى سَقَرَ","translation":{"latin":"«Sizlarni doʻzaxga nima kiritdi?» (deb)","cyrillic":"«Сизларни дўзахга нима киритди?» (деб)"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5537.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5537.mp3","juz":29,"page":576,"sajda":false},{"number":5538,"numberInSurah":43,"text":"قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ","translation":{"latin":"Alar: «Namoz oʻqiydiganlardan boʻlmagan edik.","cyrillic":"Алар: «Намоз ўқийдиганлардан бўлмаган эдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5538.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5538.mp3","juz":29,"page":576,"sajda":false},{"number":5539,"numberInSurah":44,"text":"وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ","translation":{"latin":"Va miskinlarga taom bermagan edik.","cyrillic":"Ва мискинларга таом бермаган эдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5539.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5539.mp3","juz":29,"page":576,"sajda":false},{"number":5540,"numberInSurah":45,"text":"وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ","translation":{"latin":"Va botilga shoʻngʻuvchilar bilan birga shoʻngʻir edik.","cyrillic":"Ва ботилга шўнғувчилар билан бирга шўнғир эдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5540.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5540.mp3","juz":29,"page":576,"sajda":false},{"number":5541,"numberInSurah":46,"text":"وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ","translation":{"latin":"Va qiyomat kunini yolgʻonga chiqarar edik.","cyrillic":"Ва қиёмат кунини ёлғонга чиқарар эдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5541.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5541.mp3","juz":29,"page":576,"sajda":false},{"number":5542,"numberInSurah":47,"text":"حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ","translation":{"latin":"Toki bizga oʻlim kelgunicha», derlar.","cyrillic":"Токи бизга ўлим келгунича», дерлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5542.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5542.mp3","juz":29,"page":576,"sajda":false},{"number":5543,"numberInSurah":48,"text":"فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ","translation":{"latin":"Bas, ularga shafoatchilarning shafoati manfaat bermaydir.","cyrillic":"Бас, уларга шафоатчиларнинг шафоати манфаат бермайдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5543.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5543.mp3","juz":29,"page":577,"sajda":false},{"number":5544,"numberInSurah":49,"text":"فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ","translation":{"latin":"Ularga nima boʻldiki, eslatmadan yuz oʻgirarlar.","cyrillic":"Уларга нима бўлдики, эслатмадан юз ўгирарлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5544.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5544.mp3","juz":29,"page":577,"sajda":false},{"number":5545,"numberInSurah":50,"text":"كَأَنَّهُمْ حُمُرٌۭ مُّسْتَنفِرَةٌۭ","translation":{"latin":"Xuddi qattiq qoʻrqqan eshaklar.","cyrillic":"Худди қаттиқ қўрққан эшаклар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5545.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5545.mp3","juz":29,"page":577,"sajda":false},{"number":5546,"numberInSurah":51,"text":"فَرَّتْ مِن قَسْوَرَةٍۭ","translation":{"latin":"Arslondan qochgani kabi.","cyrillic":"Арслондан қочгани каби."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5546.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5546.mp3","juz":29,"page":577,"sajda":false},{"number":5547,"numberInSurah":52,"text":"بَلْ يُرِيدُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًۭا مُّنَشَّرَةًۭ","translation":{"latin":"Balki ulardan har biri oʻziga nashr qilingan sahifalar berilishini iroda qilar.","cyrillic":"Балки улардан ҳар бири ўзига нашр қилинган саҳифалар берилишини ирода қилар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5547.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5547.mp3","juz":29,"page":577,"sajda":false},{"number":5548,"numberInSurah":53,"text":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ","translation":{"latin":"Yoʻq! Balki ular oxiratdan qoʻrqmaslar.","cyrillic":"Йўқ! Балки улар охиратдан қўрқмаслар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5548.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5548.mp3","juz":29,"page":577,"sajda":false},{"number":5549,"numberInSurah":54,"text":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌۭ","translation":{"latin":"Yoʻq! Albatta, u(Qurʼon) eslatmadur.","cyrillic":"Йўқ! Албатта, у(Қуръон) эслатмадур."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5549.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5549.mp3","juz":29,"page":577,"sajda":false},{"number":5550,"numberInSurah":55,"text":"فَمَن شَآءَ ذَكَرَهُۥ","translation":{"latin":"Bas, kim xohlasa, uni eslaydir.","cyrillic":"Бас, ким хоҳласа, уни эслайдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5550.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5550.mp3","juz":29,"page":577,"sajda":false},{"number":5551,"numberInSurah":56,"text":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ","translation":{"latin":"Va faqat Alloh xohlasagina, eslarlar. U zot taqvo ahlidir va magʻfirat ahlidir.","cyrillic":"Ва фақат Аллоҳ хоҳласагина, эсларлар. У зот тақво аҳлидир ва мағфират аҳлидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5551.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5551.mp3","juz":29,"page":577,"sajda":false}]}