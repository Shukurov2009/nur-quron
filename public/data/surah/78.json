{"number":78,"nameUz":"Naba","nameCyr":"Наба","nameArabic":"النَّبَإِ","nameEnglish":"An-Naba","englishNameTranslation":"The Announcement","revelation":"Makkiy","ayahCount":40,"ayahs":[{"number":5673,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ","translation":{"latin":"Nima haqida soʻrashadi?","cyrillic":"Нима ҳақида сўрашади?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5673.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5673.mp3","juz":30,"page":582,"sajda":false},{"number":5674,"numberInSurah":2,"text":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","translation":{"latin":"Ulkan, muhim xabar haqida.","cyrillic":"Улкан, муҳим хабар ҳақида."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5674.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5674.mp3","juz":30,"page":582,"sajda":false},{"number":5675,"numberInSurah":3,"text":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","translation":{"latin":"Shunday xabarki, ular uning haqida ixtilofdadirlar.","cyrillic":"Шундай хабарки, улар унинг ҳақида ихтилофдадирлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5675.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5675.mp3","juz":30,"page":582,"sajda":false},{"number":5676,"numberInSurah":4,"text":"كَلَّا سَيَعْلَمُونَ","translation":{"latin":"Yoʻq! Ular tezda bilurlar.","cyrillic":"Йўқ! Улар тезда билурлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5676.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5676.mp3","juz":30,"page":582,"sajda":false},{"number":5677,"numberInSurah":5,"text":"ثُمَّ كَلَّا سَيَعْلَمُونَ","translation":{"latin":"Yana yoʻq! Ular tezda bilurlar!","cyrillic":"Яна йўқ! Улар тезда билурлар!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5677.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5677.mp3","juz":30,"page":582,"sajda":false},{"number":5678,"numberInSurah":6,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا","translation":{"latin":"Yerni beshikdek moslab qoʻymadikmi?","cyrillic":"Ерни бешикдек мослаб қўймадикми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5678.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5678.mp3","juz":30,"page":582,"sajda":false},{"number":5679,"numberInSurah":7,"text":"وَٱلْجِبَالَ أَوْتَادًۭا","translation":{"latin":"Va togʻlarni qoziq (qilib qoʻymadikmi?).","cyrillic":"Ва тоғларни қозиқ (қилиб қўймадикми?)."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5679.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5679.mp3","juz":30,"page":582,"sajda":false},{"number":5680,"numberInSurah":8,"text":"وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا","translation":{"latin":"Va sizlarni juft qilib yaratdik.","cyrillic":"Ва сизларни жуфт қилиб яратдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5680.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5680.mp3","juz":30,"page":582,"sajda":false},{"number":5681,"numberInSurah":9,"text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا","translation":{"latin":"Va uyqularingizni rohat qilib qoʻydik.","cyrillic":"Ва уйқуларингизни роҳат қилиб қўйдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5681.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5681.mp3","juz":30,"page":582,"sajda":false},{"number":5682,"numberInSurah":10,"text":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا","translation":{"latin":"Va kechasini libos qildik.","cyrillic":"Ва кечасини либос қилдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5682.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5682.mp3","juz":30,"page":582,"sajda":false},{"number":5683,"numberInSurah":11,"text":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا","translation":{"latin":"Va kunduzni maosh (tirikchilik) vaqti qildik.","cyrillic":"Ва кундузни маош (тирикчилик) вақти қилдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5683.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5683.mp3","juz":30,"page":582,"sajda":false},{"number":5684,"numberInSurah":12,"text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا","translation":{"latin":"Tepangizga etti mustahkam(osmon)ni bino qildik.","cyrillic":"Тепангизга етти мустаҳкам(осмон)ни бино қилдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5684.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5684.mp3","juz":30,"page":582,"sajda":false},{"number":5685,"numberInSurah":13,"text":"وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا","translation":{"latin":"Va shuʼla taratuvchi chiroq ham qildik.","cyrillic":"Ва шуъла таратувчи чироқ ҳам қилдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5685.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5685.mp3","juz":30,"page":582,"sajda":false},{"number":5686,"numberInSurah":14,"text":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا","translation":{"latin":"Va siqilgan(bulut)lardan oquvchi suvlar tushirdik.","cyrillic":"Ва сиқилган(булут)лардан оқувчи сувлар туширдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5686.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5686.mp3","juz":30,"page":582,"sajda":false},{"number":5687,"numberInSurah":15,"text":"لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا","translation":{"latin":"U(suv) bilan don va nabotot chiqarishimiz uchun.","cyrillic":"У(сув) билан дон ва наботот чиқаришимиз учун."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5687.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5687.mp3","juz":30,"page":582,"sajda":false},{"number":5688,"numberInSurah":16,"text":"وَجَنَّٰتٍ أَلْفَافًا","translation":{"latin":"Va daraxtlari bir-biriga kirishgan boʻstonlar.","cyrillic":"Ва дарахтлари бир-бирига киришган бўстонлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5688.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5688.mp3","juz":30,"page":582,"sajda":false},{"number":5689,"numberInSurah":17,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا","translation":{"latin":"Albatta, ajrim kuni vaqti belgilangan edi.","cyrillic":"Албатта, ажрим куни вақти белгиланган эди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5689.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5689.mp3","juz":30,"page":582,"sajda":false},{"number":5690,"numberInSurah":18,"text":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا","translation":{"latin":"U kunda surga puflanur va sizlar toʻp-toʻp boʻlib kelursiz.","cyrillic":"У кунда сурга пуфланур ва сизлар тўп-тўп бўлиб келурсиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5690.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5690.mp3","juz":30,"page":582,"sajda":false},{"number":5691,"numberInSurah":19,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا","translation":{"latin":"Osmon yorilib eshiklar ochilur.","cyrillic":"Осмон ёрилиб эшиклар очилур."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5691.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5691.mp3","juz":30,"page":582,"sajda":false},{"number":5692,"numberInSurah":20,"text":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","translation":{"latin":"Togʻlar oʻrnidan koʻchirilib, sarobga aylanur.","cyrillic":"Тоғлар ўрнидан кўчирилиб, саробга айланур."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5692.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5692.mp3","juz":30,"page":582,"sajda":false},{"number":5693,"numberInSurah":21,"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا","translation":{"latin":"Albatta, jahannam poylab turuvchidir.","cyrillic":"Албатта, жаҳаннам пойлаб турувчидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5693.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5693.mp3","juz":30,"page":582,"sajda":false},{"number":5694,"numberInSurah":22,"text":"لِّلطَّٰغِينَ مَـَٔابًۭا","translation":{"latin":"Tugʻyonga ketganlarning qaytar joyidir.","cyrillic":"Туғёнга кетганларнинг қайтар жойидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5694.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5694.mp3","juz":30,"page":582,"sajda":false},{"number":5695,"numberInSurah":23,"text":"لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا","translation":{"latin":"Ular (unda) zamonlar boʻyi qolarlar.","cyrillic":"Улар (унда) замонлар бўйи қоларлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5695.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5695.mp3","juz":30,"page":582,"sajda":false},{"number":5696,"numberInSurah":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا","translation":{"latin":"Ular (unda) sovuqni ham, sharobni ham tatiy olmaslar.","cyrillic":"Улар (унда) совуқни ҳам, шаробни ҳам татий олмаслар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5696.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5696.mp3","juz":30,"page":582,"sajda":false},{"number":5697,"numberInSurah":25,"text":"إِلَّا حَمِيمًۭا وَغَسَّاقًۭا","translation":{"latin":"Magar qaynoq suv va yiringni (tatirlar).","cyrillic":"Магар қайноқ сув ва йирингни (татирлар)."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5697.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5697.mp3","juz":30,"page":582,"sajda":false},{"number":5698,"numberInSurah":26,"text":"جَزَآءًۭ وِفَاقًا","translation":{"latin":"Muvofiq jazo oʻlaroq.","cyrillic":"Мувофиқ жазо ўлароқ."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5698.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5698.mp3","juz":30,"page":582,"sajda":false},{"number":5699,"numberInSurah":27,"text":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا","translation":{"latin":"Chunki, ular hisob-kitob boʻlishiga ishonmasdilar.","cyrillic":"Чунки, улар ҳисоб-китоб бўлишига ишонмасдилар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5699.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5699.mp3","juz":30,"page":582,"sajda":false},{"number":5700,"numberInSurah":28,"text":"وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا","translation":{"latin":"Va Bizning oyatlarimizni yolgʻon deyishgan edi, yolgʻon!","cyrillic":"Ва Бизнинг оятларимизни ёлғон дейишган эди, ёлғон!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5700.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5700.mp3","juz":30,"page":582,"sajda":false},{"number":5701,"numberInSurah":29,"text":"وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا","translation":{"latin":"Biz har bir narsani kitobga jamlab qoʻyganmiz.","cyrillic":"Биз ҳар бир нарсани китобга жамлаб қўйганмиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5701.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5701.mp3","juz":30,"page":582,"sajda":false},{"number":5702,"numberInSurah":30,"text":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","translation":{"latin":"Bas, tatib koʻringlar, sizlarga azobdan boshqa hech narsani ziyoda qilmasmiz.","cyrillic":"Бас, татиб кўринглар, сизларга азобдан бошқа ҳеч нарсани зиёда қилмасмиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5702.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5702.mp3","juz":30,"page":582,"sajda":false},{"number":5703,"numberInSurah":31,"text":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","translation":{"latin":"Albatta, taqvodorlarga yutuq bordir.","cyrillic":"Албатта, тақводорларга ютуқ бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5703.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5703.mp3","juz":30,"page":583,"sajda":false},{"number":5704,"numberInSurah":32,"text":"حَدَآئِقَ وَأَعْنَٰبًۭا","translation":{"latin":"Bogʻ-rogʻlar, uzumzorlar bordir.","cyrillic":"Боғ-роғлар, узумзорлар бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5704.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5704.mp3","juz":30,"page":583,"sajda":false},{"number":5705,"numberInSurah":33,"text":"وَكَوَاعِبَ أَتْرَابًۭا","translation":{"latin":"Va yangi boʻyi etgan bir xil yoshdagi qizlar bordir.","cyrillic":"Ва янги бўйи етган бир хил ёшдаги қизлар бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5705.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5705.mp3","juz":30,"page":583,"sajda":false},{"number":5706,"numberInSurah":34,"text":"وَكَأْسًۭا دِهَاقًۭا","translation":{"latin":"Va toʻldirilgan qadahlar bordir.","cyrillic":"Ва тўлдирилган қадаҳлар бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5706.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5706.mp3","juz":30,"page":583,"sajda":false},{"number":5707,"numberInSurah":35,"text":"لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا","translation":{"latin":"U erda bekorchi va yolgʻon gaplarni eshitmaslar.","cyrillic":"У ерда бекорчи ва ёлғон гапларни эшитмаслар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5707.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5707.mp3","juz":30,"page":583,"sajda":false},{"number":5708,"numberInSurah":36,"text":"جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا","translation":{"latin":"Robbingdan mukofot, sovgʻa hisobidandir.","cyrillic":"Роббингдан мукофот, совға ҳисобидандир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5708.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5708.mp3","juz":30,"page":583,"sajda":false},{"number":5709,"numberInSurah":37,"text":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا","translation":{"latin":"U, osmonlar, er va ularning orasidagi barcha narsalarning Robbi, Rohmandir. Uning huzurida hech kim xitob qilishga qodir boʻlmas.","cyrillic":"У, осмонлар, ер ва уларнинг орасидаги барча нарсаларнинг Робби, Роҳмандир. Унинг ҳузурида ҳеч ким хитоб қилишга қодир бўлмас."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5709.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5709.mp3","juz":30,"page":583,"sajda":false},{"number":5710,"numberInSurah":38,"text":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا","translation":{"latin":"Oʻsha kunda Ruh va farishtalar saf boʻlib turar. Rohman izn berganlar va toʻgʻri soʻzlaganlardan oʻzgalar hech gapira olmaslar.","cyrillic":"Ўша кунда Руҳ ва фаришталар саф бўлиб турар. Роҳман изн берганлар ва тўғри сўзлаганлардан ўзгалар ҳеч гапира олмаслар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5710.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5710.mp3","juz":30,"page":583,"sajda":false},{"number":5711,"numberInSurah":39,"text":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","translation":{"latin":"U haq kundir. Kim xohlasa, oʻz Robbiga qaytar yoʻl oladir.","cyrillic":"У ҳақ кундир. Ким хоҳласа, ўз Роббига қайтар йўл оладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5711.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5711.mp3","juz":30,"page":583,"sajda":false},{"number":5712,"numberInSurah":40,"text":"إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا","translation":{"latin":"Albatta, Biz sizlarni yaqin kelajakdagi azobdan qoʻrqitdik. U kunda, har kishi qoʻli taqdim qilgan narsaga nazar soladir. Va kofir. «Koshki tuproq boʻlib ketsam», deydir.","cyrillic":"Албатта, Биз сизларни яқин келажакдаги азобдан қўрқитдик. У кунда, ҳар киши қўли тақдим қилган нарсага назар соладир. Ва кофир. «Кошки тупроқ бўлиб кетсам», дейдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5712.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5712.mp3","juz":30,"page":583,"sajda":false}]}