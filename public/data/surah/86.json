{"number":86,"nameUz":"Toriq","nameCyr":"Ториқ","nameArabic":"الطَّارِقِ","nameEnglish":"At-Taariq","englishNameTranslation":"The Morning Star","revelation":"Makkiy","ayahCount":17,"ayahs":[{"number":5932,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","translation":{"latin":"Osmon bilan qasam va toriq bilan qasam.","cyrillic":"Осмон билан қасам ва ториқ билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5932.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5932.mp3","juz":30,"page":591,"sajda":false},{"number":5933,"numberInSurah":2,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","translation":{"latin":"Toriq nimaligini senga ne bildirdi?","cyrillic":"Ториқ нималигини сенга не билдирди?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5933.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5933.mp3","juz":30,"page":591,"sajda":false},{"number":5934,"numberInSurah":3,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ","translation":{"latin":"U, nur sochib turuvchi yulduzdir.","cyrillic":"У, нур сочиб турувчи юлдуздир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5934.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5934.mp3","juz":30,"page":591,"sajda":false},{"number":5935,"numberInSurah":4,"text":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","translation":{"latin":"Hech bir jon yoʻqki, uning hifz qilib turuvchisi boʻlmasa.","cyrillic":"Ҳеч бир жон йўқки, унинг ҳифз қилиб турувчиси бўлмаса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5935.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5935.mp3","juz":30,"page":591,"sajda":false},{"number":5936,"numberInSurah":5,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","translation":{"latin":"Inson nimadan yaralganiga nazar solsin.","cyrillic":"Инсон нимадан яралганига назар солсин."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5936.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5936.mp3","juz":30,"page":591,"sajda":false},{"number":5937,"numberInSurah":6,"text":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","translation":{"latin":"U otilib chiquvchi suvdan yaralgandir.","cyrillic":"У отилиб чиқувчи сувдан яралгандир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5937.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5937.mp3","juz":30,"page":591,"sajda":false},{"number":5938,"numberInSurah":7,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","translation":{"latin":"U (suv) sulb (orqa umurtqa) va taroib (koʻkrak suyagi) orasidan chiqadir.","cyrillic":"У (сув) сулб (орқа умуртқа) ва тароиб (кўкрак суяги) орасидан чиқадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5938.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5938.mp3","juz":30,"page":591,"sajda":false},{"number":5939,"numberInSurah":8,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","translation":{"latin":"Albatta, U zot uni qayta tiriltirishga qodirdir.","cyrillic":"Албатта, У зот уни қайта тирилтиришга қодирдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5939.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5939.mp3","juz":30,"page":591,"sajda":false},{"number":5940,"numberInSurah":9,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","translation":{"latin":"Sirlar fosh boʻladigan kundadir.","cyrillic":"Сирлар фош бўладиган кундадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5940.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5940.mp3","juz":30,"page":591,"sajda":false},{"number":5941,"numberInSurah":10,"text":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","translation":{"latin":"Bas (oʻshanda) u(inson)da quvvat ham, nusrat beruvchi ham boʻlmaydir.","cyrillic":"Бас (ўшанда) у(инсон)да қувват ҳам, нусрат берувчи ҳам бўлмайдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5941.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5941.mp3","juz":30,"page":591,"sajda":false},{"number":5942,"numberInSurah":11,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","translation":{"latin":"Qaytuvchi sohibi boʻlgan osmon bilan qasam.","cyrillic":"Қайтувчи соҳиби бўлган осмон билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5942.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5942.mp3","juz":30,"page":591,"sajda":false},{"number":5943,"numberInSurah":12,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","translation":{"latin":"Yorib chiquvchi egasi boʻlgan er bilan qasam.","cyrillic":"Ёриб чиқувчи эгаси бўлган ер билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5943.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5943.mp3","juz":30,"page":591,"sajda":false},{"number":5944,"numberInSurah":13,"text":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","translation":{"latin":"Albatta, u (Qurʼon) ajratuvchi soʻzdir.","cyrillic":"Албатта, у (Қуръон) ажратувчи сўздир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5944.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5944.mp3","juz":30,"page":591,"sajda":false},{"number":5945,"numberInSurah":14,"text":"وَمَا هُوَ بِٱلْهَزْلِ","translation":{"latin":"Va u hazil emasdir.","cyrillic":"Ва у ҳазил эмасдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5945.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5945.mp3","juz":30,"page":591,"sajda":false},{"number":5946,"numberInSurah":15,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","translation":{"latin":"Albatta, ular hiyla qiladir.","cyrillic":"Албатта, улар ҳийла қиладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5946.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5946.mp3","juz":30,"page":591,"sajda":false},{"number":5947,"numberInSurah":16,"text":"وَأَكِيدُ كَيْدًۭا","translation":{"latin":"Va Men ham «hiyla» qilurman.","cyrillic":"Ва Мен ҳам «ҳийла» қилурман."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5947.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5947.mp3","juz":30,"page":591,"sajda":false},{"number":5948,"numberInSurah":17,"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","translation":{"latin":"Bas, kofirlarga muhlat ber. Ha, ularga ozgina muhlat ber.","cyrillic":"Бас, кофирларга муҳлат бер. Ҳа, уларга озгина муҳлат бер."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5948.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5948.mp3","juz":30,"page":591,"sajda":false}]}