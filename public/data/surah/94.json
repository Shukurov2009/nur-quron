{"number":94,"nameUz":"Sharh","nameCyr":"Шарҳ","nameArabic":"الشَّرۡحِ","nameEnglish":"Ash-Sharh","englishNameTranslation":"The Consolation","revelation":"Makkiy","ayahCount":8,"ayahs":[{"number":6091,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","translation":{"latin":"Sening koʻksingni keng qilib qoʻymadikmi?","cyrillic":"Сенинг кўксингни кенг қилиб қўймадикми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6091.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6091.mp3","juz":30,"page":596,"sajda":false},{"number":6092,"numberInSurah":2,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ","translation":{"latin":"Va sening yukingni engillatmadikmi?","cyrillic":"Ва сенинг юкингни енгиллатмадикми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6092.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6092.mp3","juz":30,"page":596,"sajda":false},{"number":6093,"numberInSurah":3,"text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","translation":{"latin":"Yelkangni bosib turganni?","cyrillic":"Елкангни босиб турганни?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6093.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6093.mp3","juz":30,"page":596,"sajda":false},{"number":6094,"numberInSurah":4,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَ","translation":{"latin":"Va sening zikringni yuqori koʻtarmadikmi?","cyrillic":"Ва сенинг зикрингни юқори кўтармадикми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6094.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6094.mp3","juz":30,"page":596,"sajda":false},{"number":6095,"numberInSurah":5,"text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","translation":{"latin":"Bas, albatta, qiyinchilik bilan osonchilik bordir.","cyrillic":"Бас, албатта, қийинчилик билан осончилик бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6095.mp3","audio64":"https://cdn.islamic.net