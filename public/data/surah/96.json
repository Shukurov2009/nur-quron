{"number":96,"nameUz":"Alaq","nameCyr":"Алақ","nameArabic":"العَلَقِ","nameEnglish":"Al-Alaq","englishNameTranslation":"The Clot","revelation":"Makkiy","ayahCount":19,"ayahs":[{"number":6107,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","translation":{"latin":"Yaratgan Robbing nomi bilan oʻqi.","cyrillic":"Яратган Роббинг номи билан ўқи."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6107.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6107.mp3","juz":30,"page":597,"sajda":false},{"number":6108,"numberInSurah":2,"text":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","translation":{"latin":"U insonni alaqdan yaratdi.","cyrillic":"У инсонни алақдан яратди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6108.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6108.mp3","juz":30,"page":597,"sajda":false},{"number":6109,"numberInSurah":3,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","translation":{"latin":"Oʻqi! Robbing Karamlilarning karamlisidir.","cyrillic":"Ўқи! Роббинг Карамлиларнинг карамлисидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6109.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6109.mp3","juz":30,"page":597,"sajda":false},{"number":6110,"numberInSurah":4,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","translation":{"latin":"U, qalam bilan ilm oʻrgatgandir.","cyrillic":"У, қалам билан илм ўргатгандир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6110.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6110.mp3","juz":30,"page":597,"sajda":false},{"number":6111,"numberInSurah":5,"text":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","translation":{"latin":"U, insonga bilmagan narsasini oʻrgatdi.","cyrillic":"У, инсонга билмаган нарсасини ўргатди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6111.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6111.mp3","juz":30,"page":597,"sajda":false},{"number":6112,"numberInSurah":6,"text":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","translation":{"latin":"Yoʻq! Inson, albatta, tugʻyonga ketur.","cyrillic":"Йўқ! Инсон, албатта, туғёнга кетур."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6112.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6112.mp3","juz":30,"page":597,"sajda":false},{"number":6113,"numberInSurah":7,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","translation":{"latin":"Gar oʻzini boy koʻrsa.","cyrillic":"Гар ўзини бой кўрса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6113.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6113.mp3","juz":30,"page":597,"sajda":false},{"number":6114,"numberInSurah":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","translation":{"latin":"Albatta, qaytib borish Robbinggadir.","cyrillic":"Албатта, қайтиб бориш Роббинггадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6114.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6114.mp3","juz":30,"page":597,"sajda":false},{"number":6115,"numberInSurah":9,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","translation":{"latin":"Qaytarganni koʻrdingmi?!","cyrillic":"Қайтарганни кўрдингми?!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6115.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6115.mp3","juz":30,"page":597,"sajda":false},{"number":6116,"numberInSurah":10,"text":"عَبْدًا إِذَا صَلَّىٰٓ","translation":{"latin":"Bandani namoz oʻqiyotganida?!","cyrillic":"Бандани намоз ўқиётганида?!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6116.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6116.mp3","juz":30,"page":597,"sajda":false},{"number":6117,"numberInSurah":11,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","translation":{"latin":"Ayting-chi, agar oʻsha hidoyatda boʻlsa.","cyrillic":"Айтинг-чи, агар ўша ҳидоятда бўлса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6117.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6117.mp3","juz":30,"page":597,"sajda":false},{"number":6118,"numberInSurah":12,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","translation":{"latin":"Yoki taqvoga chaqirsa.","cyrillic":"Ёки тақвога чақирса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6118.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6118.mp3","juz":30,"page":597,"sajda":false},{"number":6119,"numberInSurah":13,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","translation":{"latin":"Ayting-chi, agar u yolgʻonga chiqarsa va yuz oʻgirsa.","cyrillic":"Айтинг-чи, агар у ёлғонга чиқарса ва юз ўгирса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6119.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6119.mp3","juz":30,"page":597,"sajda":false},{"number":6120,"numberInSurah":14,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","translation":{"latin":"Alloh uni koʻrib turishini bilmasmi?","cyrillic":"Аллоҳ уни кўриб туришини билмасми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6120.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6120.mp3","juz":30,"page":597,"sajda":false},{"number":6121,"numberInSurah":15,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","translation":{"latin":"Yoʻq! Agar qaytmasa, peshonasidan shiddat-la tutamiz!","cyrillic":"Йўқ! Агар қайтмаса, пешонасидан шиддат-ла тутамиз!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6121.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6121.mp3","juz":30,"page":597,"sajda":false},{"number":6122,"numberInSurah":16,"text":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","translation":{"latin":"Yolgʻonchi, xatokor peshonasidan!","cyrillic":"Ёлғончи, хатокор пешонасидан!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6122.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6122.mp3","juz":30,"page":597,"sajda":false},{"number":6123,"numberInSurah":17,"text":"فَلْيَدْعُ نَادِيَهُۥ","translation":{"latin":"Bas, u oʻz toʻpini chaqirsin.","cyrillic":"Бас, у ўз тўпини чақирсин."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6123.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6123.mp3","juz":30,"page":597,"sajda":false},{"number":6124,"numberInSurah":18,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ","translation":{"latin":"Biz ham zaboniyalarni chaqirurmiz.","cyrillic":"Биз ҳам забонияларни чақирурмиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6124.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6124.mp3","juz":30,"page":597,"sajda":false},{"number":6125,"numberInSurah":19,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","translation":{"latin":"Yoʻq! Sen unga itoat qilma! Sajda qil va qurbat hosil qil.","cyrillic":"Йўқ! Сен унга итоат қилма! Сажда қил ва қурбат ҳосил қил."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6125.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6125.mp3","juz":30,"page":597,"sajda":true}]}