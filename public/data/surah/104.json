{"number":104,"nameUz":"Humaza","nameCyr":"Ҳумаза","nameArabic":"الهُمَزَةِ","nameEnglish":"Al-Humaza","englishNameTranslation":"The Traducer","revelation":"Makkiy","ayahCount":9,"ayahs":[{"number":6180,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","translation":{"latin":"Har bir obroʻ toʻkuvchi va ayblovchiga «vayl» boʻlsin.","cyrillic":"Ҳар бир обрў тўкувчи ва айбловчига «вайл» бўлсин."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6180.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6180.mp3","juz":30,"page":601,"sajda":false},{"number":6181,"numberInSurah":2,"text":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","translation":{"latin":"U mol jamladi va uni sanab turur.","cyrillic":"У мол жамлади ва уни санаб турур."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6181.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6181.mp3","juz":30,"page":601,"sajda":false},{"number":6182,"numberInSurah":3,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","translation":{"latin":"U, albatta, moli uni abadiy qoldirur deb hisob qilur.","cyrillic":"У, албатта, моли уни абадий қолдирур деб ҳисоб қилур."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6182.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6182.mp3","juz":30,"page":601,"sajda":false},{"number":6183,"numberInSurah":4,"text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","translation":{"latin":"Yoʻq! Albatta, u «hutoma»ga xor-zor etib tashlanur.","cyrillic":"Йўқ! Албатта, у «ҳутома»га хор-зор этиб ташланур."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6183.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6183.mp3","juz":30,"page":601,"sajda":false},{"number":6184,"numberInSurah":5,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","translation":{"latin":"«Hutoma» qandoq narsa ekanini senga nima bildirur?","cyrillic":"«Ҳутома» қандоқ нарса эканини сенга нима билдирур?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6184.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6184.mp3","juz":30,"page":601,"sajda":false},{"number":6185,"numberInSurah":6,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","translation":{"latin":"U, Allohning shiddatli, oʻchmas olovidir.","cyrillic":"У, Аллоҳнинг шиддатли, ўчмас оловидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6185.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6185.mp3","juz":30,"page":601,"sajda":false},{"number":6186,"numberInSurah":7,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","translation":{"latin":"Qalblargacha etib boradigandur.","cyrillic":"Қалбларгача етиб борадигандур."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6186.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6186.mp3","juz":30,"page":601,"sajda":false},{"number":6187,"numberInSurah":8,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","translation":{"latin":"Albatta, u ularning ustidan qoplangandir.","cyrillic":"Албатта, у уларнинг устидан қоплангандир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6187.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6187.mp3","juz":30,"page":601,"sajda":false},{"number":6188,"numberInSurah":9,"text":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","translation":{"latin":"Uzun-uzun ustunlarga bogʻlangandir.","cyrillic":"Узун-узун устунларга боғлангандир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6188.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6188.mp3","juz":30,"page":601,"sajda":false}]}