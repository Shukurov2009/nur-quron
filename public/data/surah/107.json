{"number":107,"nameUz":"Mo'un","nameCyr":"Моун","nameArabic":"المَاعُونِ","nameEnglish":"Al-Maa'un","englishNameTranslation":"Almsgiving","revelation":"Makkiy","ayahCount":7,"ayahs":[{"number":6198,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","translation":{"latin":"Oxirat(jazosi)ni yolgʻonga chiqaruvchini koʻrdingmi?","cyrillic":"Охират(жазоси)ни ёлғонга чиқарувчини кўрдингми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6198.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6198.mp3","juz":30,"page":602,"sajda":false},{"number":6199,"numberInSurah":2,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","translation":{"latin":"U, etimni qoʻpollik bilan haydaydir.","cyrillic":"У, етимни қўполлик билан ҳайдайдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6199.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6199.mp3","juz":30,"page":602,"sajda":false},{"number":6200,"numberInSurah":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translation":{"latin":"Va miskinlarga taom berishga qiziqtirmaydir.","cyrillic":"Ва мискинларга таом беришга қизиқтирмайдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6200.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6200.mp3","juz":30,"page":602,"sajda":false},{"number":6201,"numberInSurah":4,"text":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","translation":{"latin":"Bir «namozxonlar»ga vayl boʻlsinki.","cyrillic":"Бир «намозхонлар»га вайл бўлсинки."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6201.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6201.mp3","juz":30,"page":602,"sajda":false},{"number":6202,"numberInSurah":5,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","translation":{"latin":"Ular namozlarini unutuvchilardir.","cyrillic":"Улар намозларини унутувчилардир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6202.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6202.mp3","juz":30,"page":602,"sajda":false},{"number":6203,"numberInSurah":6,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","translation":{"latin":"Undoq kishilar riyo qiladiganlardir.","cyrillic":"Ундоқ кишилар риё қиладиганлардир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6203.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6203.mp3","juz":30,"page":602,"sajda":false},{"number":6204,"numberInSurah":7,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","translation":{"latin":"Va maaʼuunni man qiladiganlardir.","cyrillic":"Ва мааъуунни ман қиладиганлардир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6204.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6204.mp3","juz":30,"page":602,"sajda":false}]}