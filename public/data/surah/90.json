{"number":90,"nameUz":"Balad","nameCyr":"Балад","nameArabic":"البَلَدِ","nameEnglish":"Al-Balad","englishNameTranslation":"The City","revelation":"Makkiy","ayahCount":20,"ayahs":[{"number":6024,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ","translation":{"latin":"Mana shu shahar bilan qasam.","cyrillic":"Мана шу шаҳар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6024.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6024.mp3","juz":30,"page":594,"sajda":false},{"number":6025,"numberInSurah":2,"text":"وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ","translation":{"latin":"Sen muqim turgan bu shahar-la.","cyrillic":"Сен муқим турган бу шаҳар-ла."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6025.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6025.mp3","juz":30,"page":594,"sajda":false},{"number":6026,"numberInSurah":3,"text":"وَوَالِدٍۢ وَمَا وَلَدَ","translation":{"latin":"Va Volid va undan tarqagan valadlar bilan qasam.","cyrillic":"Ва Волид ва ундан тарқаган валадлар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6026.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6026.mp3","juz":30,"page":594,"sajda":false},{"number":6027,"numberInSurah":4,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ","translation":{"latin":"Batahqiq, Biz insonni mashaqqatda yaratdik.","cyrillic":"Батаҳқиқ, Биз инсонни машаққатда яратдик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6027.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6027.mp3","juz":30,"page":594,"sajda":false},{"number":6028,"numberInSurah":5,"text":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ","translation":{"latin":"U inson unga hech kimning kuchi etmas, deb hisoblarmi?","cyrillic":"У инсон унга ҳеч кимнинг кучи етмас, деб ҳисобларми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6028.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6028.mp3","juz":30,"page":594,"sajda":false},{"number":6029,"numberInSurah":6,"text":"يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا","translation":{"latin":"U: «Koʻplab mol-dunyo nafaqa qildim», deydir.","cyrillic":"У: «Кўплаб мол-дунё нафақа қилдим», дейдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6029.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6029.mp3","juz":30,"page":594,"sajda":false},{"number":6030,"numberInSurah":7,"text":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ","translation":{"latin":"U oʻzini birov koʻrmadi, deb hisoblaydirmi?","cyrillic":"У ўзини биров кўрмади, деб ҳисоблайдирми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6030.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6030.mp3","juz":30,"page":594,"sajda":false},{"number":6031,"numberInSurah":8,"text":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","translation":{"latin":"Biz unga ikki koʻzni.","cyrillic":"Биз унга икки кўзни."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6031.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6031.mp3","juz":30,"page":594,"sajda":false},{"number":6032,"numberInSurah":9,"text":"وَلِسَانًۭا وَشَفَتَيْنِ","translation":{"latin":"Va tilni va ikki labni bermadikmi?","cyrillic":"Ва тилни ва икки лабни бермадикми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6032.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6032.mp3","juz":30,"page":594,"sajda":false},{"number":6033,"numberInSurah":10,"text":"وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ","translation":{"latin":"Va Biz uni ikki yoʻlga yoʻllab qoʻymadikmi?","cyrillic":"Ва Биз уни икки йўлга йўллаб қўймадикми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6033.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6033.mp3","juz":30,"page":594,"sajda":false},{"number":6034,"numberInSurah":11,"text":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ","translation":{"latin":"Bas, u dovon oshib oʻtmadi.","cyrillic":"Бас, у довон ошиб ўтмади."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6034.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6034.mp3","juz":30,"page":594,"sajda":false},{"number":6035,"numberInSurah":12,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","translation":{"latin":"Dovon qandoq narsa ekanini senga nima bildirdi?","cyrillic":"Довон қандоқ нарса эканини сенга нима билдирди?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6035.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6035.mp3","juz":30,"page":594,"sajda":false},{"number":6036,"numberInSurah":13,"text":"فَكُّ رَقَبَةٍ","translation":{"latin":"U qul ozod qilishdir.","cyrillic":"У қул озод қилишдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6036.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6036.mp3","juz":30,"page":594,"sajda":false},{"number":6037,"numberInSurah":14,"text":"أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ","translation":{"latin":"Yoki ocharchilik kunida taom berishdir.","cyrillic":"Ёки очарчилик кунида таом беришдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6037.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6037.mp3","juz":30,"page":594,"sajda":false},{"number":6038,"numberInSurah":15,"text":"يَتِيمًۭا ذَا مَقْرَبَةٍ","translation":{"latin":"Qarindosh etimga.","cyrillic":"Қариндош етимга."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6038.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6038.mp3","juz":30,"page":594,"sajda":false},{"number":6039,"numberInSurah":16,"text":"أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ","translation":{"latin":"Yoki tuproqqa qorilgan miskinga.","cyrillic":"Ёки тупроққа қорилган мискинга."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6039.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6039.mp3","juz":30,"page":594,"sajda":false},{"number":6040,"numberInSurah":17,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ","translation":{"latin":"Soʻngra, iymon keltirganlar va bir-birini sabrga, mehr-shafqatga chaqirganlar boʻlsa...","cyrillic":"Сўнгра, иймон келтирганлар ва бир-бирини сабрга, меҳр-шафқатга чақирганлар бўлса..."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6040.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6040.mp3","juz":30,"page":594,"sajda":false},{"number":6041,"numberInSurah":18,"text":"أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ","translation":{"latin":"Ana oʻshalar oʻng tomon egalaridir.","cyrillic":"Ана ўшалар ўнг томон эгаларидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6041.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6041.mp3","juz":30,"page":594,"sajda":false},{"number":6042,"numberInSurah":19,"text":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","translation":{"latin":"Oyatlarimizga kufr keltirganlar chap tomon egalaridir.","cyrillic":"Оятларимизга куфр келтирганлар чап томон эгаларидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6042.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6042.mp3","juz":30,"page":594,"sajda":false},{"number":6043,"numberInSurah":20,"text":"عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ","translation":{"latin":"Ularni chiqib boʻlmaydigan oʻt-olov oʻrab olgandir.","cyrillic":"Уларни чиқиб бўлмайдиган ўт-олов ўраб олгандир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6043.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6043.mp3","juz":30,"page":594,"sajda":false}]}