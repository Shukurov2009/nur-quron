{"number":87,"nameUz":"A'lo","nameCyr":"Аъло","nameArabic":"الأَعۡلَىٰ","nameEnglish":"Al-A'laa","englishNameTranslation":"The Most High","revelation":"Makkiy","ayahCount":19,"ayahs":[{"number":5949,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","translation":{"latin":"Oliy qadar boʻlgan Robbing ismini poklab yod et.","cyrillic":"Олий қадар бўлган Роббинг исмини поклаб ёд эт."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5949.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5949.mp3","juz":30,"page":591,"sajda":false},{"number":5950,"numberInSurah":2,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","translation":{"latin":"U yaratgan va mutanosib qilgan Zotdir.","cyrillic":"У яратган ва мутаносиб қилган Зотдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5950.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5950.mp3","juz":30,"page":591,"sajda":false},{"number":5951,"numberInSurah":3,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","translation":{"latin":"U, oʻlchov bilan qilgan va hidoyatga boshlagan Zotdir.","cyrillic":"У, ўлчов билан қилган ва ҳидоятга бошлаган Зотдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5951.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5951.mp3","juz":30,"page":591,"sajda":false},{"number":5952,"numberInSurah":4,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","translation":{"latin":"U, oʻt-oʻlanni chiqargan Zotdir.","cyrillic":"У, ўт-ўланни чиқарган Зотдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5952.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5952.mp3","juz":30,"page":591,"sajda":false},{"number":5953,"numberInSurah":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","translation":{"latin":"Bas, uni qoraygan xashak qilgan Zotdir.","cyrillic":"Бас, уни қорайган хашак қилган Зотдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5953.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5953.mp3","juz":30,"page":591,"sajda":false},{"number":5954,"numberInSurah":6,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","translation":{"latin":"Biz senga (Qurʼonni) qiroat qildiramiz, bas, sen uni esdan chiqarmassan.","cyrillic":"Биз сенга (Қуръонни) қироат қилдирамиз, бас, сен уни эсдан чиқармассан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5954.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5954.mp3","juz":30,"page":591,"sajda":false},{"number":5955,"numberInSurah":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","translation":{"latin":"Illo, Alloh xohlaganini. Albatta, U oshkorni ham, maxfiy narsalarni ham biladir.","cyrillic":"Илло, Аллоҳ хоҳлаганини. Албатта, У ошкорни ҳам, махфий нарсаларни ҳам биладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5955.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5955.mp3","juz":30,"page":591,"sajda":false},{"number":5956,"numberInSurah":8,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","translation":{"latin":"Va seni oson yoʻlga muyassar qilamiz.","cyrillic":"Ва сени осон йўлга муяссар қиламиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5956.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5956.mp3","juz":30,"page":591,"sajda":false},{"number":5957,"numberInSurah":9,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","translation":{"latin":"Bas, agar eslatish manfaat bersa, eslatgin.","cyrillic":"Бас, агар эслатиш манфаат берса, эслатгин."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5957.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5957.mp3","juz":30,"page":591,"sajda":false},{"number":5958,"numberInSurah":10,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","translation":{"latin":"Albatta, U zotdan qoʻrqqan esga oladir.","cyrillic":"Албатта, У зотдан қўрққан эсга оладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5958.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5958.mp3","juz":30,"page":591,"sajda":false},{"number":5959,"numberInSurah":11,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","translation":{"latin":"Va badbaxtgina undan chetda boʻladir.","cyrillic":"Ва бадбахтгина ундан четда бўладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5959.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5959.mp3","juz":30,"page":591,"sajda":false},{"number":5960,"numberInSurah":12,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","translation":{"latin":"U katta olovga kiradir.","cyrillic":"У катта оловга кирадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5960.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5960.mp3","juz":30,"page":591,"sajda":false},{"number":5961,"numberInSurah":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","translation":{"latin":"Soʻngra, uning ichida oʻlmay ham, tirilmay ham qoladir.","cyrillic":"Сўнгра, унинг ичида ўлмай ҳам, тирилмай ҳам қоладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5961.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5961.mp3","juz":30,"page":591,"sajda":false},{"number":5962,"numberInSurah":14,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","translation":{"latin":"Haqiqatan, kim pok boʻlsa, yutuq topadir.","cyrillic":"Ҳақиқатан, ким пок бўлса, ютуқ топадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5962.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5962.mp3","juz":30,"page":591,"sajda":false},{"number":5963,"numberInSurah":15,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","translation":{"latin":"Va Robbi ismini zikr qilsa va namoz oʻqisa hamdir.","cyrillic":"Ва Робби исмини зикр қилса ва намоз ўқиса ҳамдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5963.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5963.mp3","juz":30,"page":591,"sajda":false},{"number":5964,"numberInSurah":16,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","translation":{"latin":"Balki, sizlar bu dunyo hayotini ustun qoʻyasizlar.","cyrillic":"Балки, сизлар бу дунё ҳаётини устун қўясизлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5964.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5964.mp3","juz":30,"page":592,"sajda":false},{"number":5965,"numberInSurah":17,"text":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","translation":{"latin":"Holbuki, oxirat yaxshiroq va boqiyroqdir.","cyrillic":"Ҳолбуки, охират яхшироқ ва боқийроқдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5965.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5965.mp3","juz":30,"page":592,"sajda":false},{"number":5966,"numberInSurah":18,"text":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","translation":{"latin":"Albatta, bu avvalgi sahifalarda bordir.","cyrillic":"Албатта, бу аввалги саҳифаларда бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5966.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5966.mp3","juz":30,"page":592,"sajda":false},{"number":5967,"numberInSurah":19,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","translation":{"latin":"Ibrohim va Muso sahifalaridadir.","cyrillic":"Иброҳим ва Мусо саҳифаларидадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5967.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5967.mp3","juz":30,"page":592,"sajda":false}]}