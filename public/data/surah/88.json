{"number":88,"nameUz":"G'oshiya","nameCyr":"Ғошия","nameArabic":"الغَاشِيَةِ","nameEnglish":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","revelation":"Makkiy","ayahCount":26,"ayahs":[{"number":5968,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","translation":{"latin":"Batahqiq, senga gʻoshiya xabari keldi.","cyrillic":"Батаҳқиқ, сенга ғошия хабари келди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5968.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5968.mp3","juz":30,"page":592,"sajda":false},{"number":5969,"numberInSurah":2,"text":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","translation":{"latin":"Oʻshal kunda bir chehralar qoʻrqinch bilan toʻladir.","cyrillic":"Ўшал кунда бир чеҳралар қўрқинч билан тўладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5969.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5969.mp3","juz":30,"page":592,"sajda":false},{"number":5970,"numberInSurah":3,"text":"عَامِلَةٌۭ نَّاصِبَةٌۭ","translation":{"latin":"Ular ish bajaruvchidir va nihoyatda charchagandir.","cyrillic":"Улар иш бажарувчидир ва ниҳоятда чарчагандир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5970.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5970.mp3","juz":30,"page":592,"sajda":false},{"number":5971,"numberInSurah":4,"text":"تَصْلَىٰ نَارًا حَامِيَةًۭ","translation":{"latin":"Oʻta qizib turgan olovga kiradir.","cyrillic":"Ўта қизиб турган оловга кирадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5971.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5971.mp3","juz":30,"page":592,"sajda":false},{"number":5972,"numberInSurah":5,"text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","translation":{"latin":"Ular qaynab turgan buloqdan sugʻoriladir.","cyrillic":"Улар қайнаб турган булоқдан суғориладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5972.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5972.mp3","juz":30,"page":592,"sajda":false},{"number":5973,"numberInSurah":6,"text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","translation":{"latin":"Ularga tikandan boshqa taom yoʻqdir.","cyrillic":"Уларга тикандан бошқа таом йўқдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5973.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5973.mp3","juz":30,"page":592,"sajda":false},{"number":5974,"numberInSurah":7,"text":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","translation":{"latin":"U na semirtirmas va na ochlikni ketkazmasdir.","cyrillic":"У на семиртирмас ва на очликни кетказмасдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5974.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5974.mp3","juz":30,"page":592,"sajda":false},{"number":5975,"numberInSurah":8,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","translation":{"latin":"Oʻshal kunda bir chehralar neʼmat xursandligi bilan toʻladir.","cyrillic":"Ўшал кунда бир чеҳралар неъмат хурсандлиги билан тўладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5975.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5975.mp3","juz":30,"page":592,"sajda":false},{"number":5976,"numberInSurah":9,"text":"لِّسَعْيِهَا رَاضِيَةٌۭ","translation":{"latin":"Ular oʻz ishlaridan rozidir.","cyrillic":"Улар ўз ишларидан розидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5976.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5976.mp3","juz":30,"page":592,"sajda":false},{"number":5977,"numberInSurah":10,"text":"فِى جَنَّةٍ عَالِيَةٍۢ","translation":{"latin":"Ular oliy darajali jannatdadir.","cyrillic":"Улар олий даражали жаннатдадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5977.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5977.mp3","juz":30,"page":592,"sajda":false},{"number":5978,"numberInSurah":11,"text":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","translation":{"latin":"Unda bekorchi gaplarni eshitmaslar.","cyrillic":"Унда бекорчи гапларни эшитмаслар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5978.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5978.mp3","juz":30,"page":592,"sajda":false},{"number":5979,"numberInSurah":12,"text":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","translation":{"latin":"Unda oqib turgan buloqlar bordir.","cyrillic":"Унда оқиб турган булоқлар бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5979.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5979.mp3","juz":30,"page":592,"sajda":false},{"number":5980,"numberInSurah":13,"text":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","translation":{"latin":"Unda baland-baland soʻrilar bordir.","cyrillic":"Унда баланд-баланд сўрилар бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5980.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5980.mp3","juz":30,"page":592,"sajda":false},{"number":5981,"numberInSurah":14,"text":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","translation":{"latin":"Va tayyorlab qoʻyilgan qadahlar bordir.","cyrillic":"Ва тайёрлаб қўйилган қадаҳлар бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5981.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5981.mp3","juz":30,"page":592,"sajda":false},{"number":5982,"numberInSurah":15,"text":"وَنَمَارِقُ مَصْفُوفَةٌۭ","translation":{"latin":"Va saf-saf qilib tizilgan yostiqlar bordir.","cyrillic":"Ва саф-саф қилиб тизилган ёстиқлар бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5982.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5982.mp3","juz":30,"page":592,"sajda":false},{"number":5983,"numberInSurah":16,"text":"وَزَرَابِىُّ مَبْثُوثَةٌ","translation":{"latin":"Hamma yoqqa toʻshalgan gilamlar bordir.","cyrillic":"Ҳамма ёққа тўшалган гиламлар бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5983.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5983.mp3","juz":30,"page":592,"sajda":false},{"number":5984,"numberInSurah":17,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","translation":{"latin":"Ular nazar solmasmi: Tuyaning qanday yaratilganiga?","cyrillic":"Улар назар солмасми: Туянинг қандай яратилганига?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5984.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5984.mp3","juz":30,"page":592,"sajda":false},{"number":5985,"numberInSurah":18,"text":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","translation":{"latin":"Va osmonning qandoq koʻtarilganiga?","cyrillic":"Ва осмоннинг қандоқ кўтарилганига?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5985.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5985.mp3","juz":30,"page":592,"sajda":false},{"number":5986,"numberInSurah":19,"text":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","translation":{"latin":"Va togʻlarning qandoq oʻrnashtirilganiga?","cyrillic":"Ва тоғларнинг қандоқ ўрнаштирилганига?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5986.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5986.mp3","juz":30,"page":592,"sajda":false},{"number":5987,"numberInSurah":20,"text":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","translation":{"latin":"Va erning qandoq tekislab qoʻyilganiga?","cyrillic":"Ва ернинг қандоқ текислаб қўйилганига?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5987.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5987.mp3","juz":30,"page":592,"sajda":false},{"number":5988,"numberInSurah":21,"text":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","translation":{"latin":"Bas, eslatgin, sen, albatta, eslatuvchidirsan.","cyrillic":"Бас, эслатгин, сен, албатта, эслатувчидирсан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5988.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5988.mp3","juz":30,"page":592,"sajda":false},{"number":5989,"numberInSurah":22,"text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","translation":{"latin":"Sen ularning ustidan hukmingni oʻtkazuvchi emassan.","cyrillic":"Сен уларнинг устидан ҳукмингни ўтказувчи эмассан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5989.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5989.mp3","juz":30,"page":592,"sajda":false},{"number":5990,"numberInSurah":23,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","translation":{"latin":"Illo, kim yuz oʻgirsa va kofir boʻlsa...","cyrillic":"Илло, ким юз ўгирса ва кофир бўлса..."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5990.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5990.mp3","juz":30,"page":592,"sajda":false},{"number":5991,"numberInSurah":24,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","translation":{"latin":"Bas, uni Alloh katta azob bilan azoblaydir.","cyrillic":"Бас, уни Аллоҳ катта азоб билан азоблайдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5991.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5991.mp3","juz":30,"page":592,"sajda":false},{"number":5992,"numberInSurah":25,"text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","translation":{"latin":"Albatta, ularning qaytishi Bizgadir.","cyrillic":"Албатта, уларнинг қайтиши Бизгадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5992.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5992.mp3","juz":30,"page":592,"sajda":false},{"number":5993,"numberInSurah":26,"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","translation":{"latin":"Soʻngra, albatta, ularning hisob-kitobi ham Bizda boʻladir.","cyrillic":"Сўнгра, албатта, уларнинг ҳисоб-китоби ҳам Бизда бўладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5993.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5993.mp3","juz":30,"page":592,"sajda":false}]}