{"number":100,"nameUz":"Odiyat","nameCyr":"Одиёт","nameArabic":"العَادِيَاتِ","nameEnglish":"Al-Aadiyaat","englishNameTranslation":"The Chargers","revelation":"Makkiy","ayahCount":11,"ayahs":[{"number":6147,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","translation":{"latin":"Harsillab chopuvchi otlar bilan qasam.","cyrillic":"Ҳарсиллаб чопувчи отлар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6147.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6147.mp3","juz":30,"page":599,"sajda":false},{"number":6148,"numberInSurah":2,"text":"فَٱلْمُورِيَٰتِ قَدْحًۭا","translation":{"latin":"Oʻt chaqnatib chopuvchi otlar bilan qasam.","cyrillic":"Ўт чақнатиб чопувчи отлар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6148.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6148.mp3","juz":30,"page":599,"sajda":false},{"number":6149,"numberInSurah":3,"text":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","translation":{"latin":"Tong chogʻida gʻorat qiluvchi otlar bilan qasam.","cyrillic":"Тонг чоғида ғорат қилувчи отлар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6149.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6149.mp3","juz":30,"page":599,"sajda":false},{"number":6150,"numberInSurah":4,"text":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","translation":{"latin":"Oʻsha ila chang qoʻzgʻatdilar.","cyrillic":"Ўша ила чанг қўзғатдилар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6150.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6150.mp3","juz":30,"page":599,"sajda":false},{"number":6151,"numberInSurah":5,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا","translation":{"latin":"Va u ila jamoa oʻrtasiga (yorib) kirdilar.","cyrillic":"Ва у ила жамоа ўртасига (ёриб) кирдилар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6151.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6151.mp3","juz":30,"page":599,"sajda":false},{"number":6152,"numberInSurah":6,"text":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","translation":{"latin":"Albatta, inson oʻz Robbiga noshukrdir.","cyrillic":"Албатта, инсон ўз Роббига ношукрдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6152.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6152.mp3","juz":30,"page":599,"sajda":false},{"number":6153,"numberInSurah":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","translation":{"latin":"Va albatta, u ana shunga oʻzi guvohdir.","cyrillic":"Ва албатта, у ана шунга ўзи гувоҳдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6153.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6153.mp3","juz":30,"page":599,"sajda":false},{"number":6154,"numberInSurah":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","translation":{"latin":"Albatta, u mol-dunyoga haddan tashqari oʻchdir.","cyrillic":"Албатта, у мол-дунёга ҳаддан ташқари ўчдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6154.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6154.mp3","juz":30,"page":599,"sajda":false},{"number":6155,"numberInSurah":9,"text":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","translation":{"latin":"U bilmasmi?! Qabrdagilar qoʻzgʻatilganda.","cyrillic":"У билмасми?! Қабрдагилар қўзғатилганда."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6155.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6155.mp3","juz":30,"page":599,"sajda":false},{"number":6156,"numberInSurah":10,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","translation":{"latin":"Va koʻkraklaridagi oshkor boʻlganda.","cyrillic":"Ва кўкракларидаги ошкор бўлганда."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6156.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6156.mp3","juz":30,"page":600,"sajda":false},{"number":6157,"numberInSurah":11,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","translation":{"latin":"Oʻsha kunda Robbilari ulardan xabardor ekanini?!","cyrillic":"Ўша кунда Роббилари улардан хабардор эканини?!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6157.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6157.mp3","juz":30,"page":600,"sajda":false}]}