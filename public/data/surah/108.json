{"number":108,"nameUz":"Kavsar","nameCyr":"Кавсар","nameArabic":"الكَوۡثَرِ","nameEnglish":"Al-Kawthar","englishNameTranslation":"Abundance","revelation":"Makkiy","ayahCount":3,"ayahs":[{"number":6205,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","translation":{"latin":"Albatta, Biz senga Kavsarni berdik.","cyrillic":"Албатта, Биз сенга Кавсарни бердик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6205.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6205.mp3","juz":30,"page":602,"sajda":false},{"number":6206,"numberInSurah":2,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","translation":{"latin":"Bas, Robbingga namoz oʻqi va jonliq soʻy.","cyrillic":"Бас, Роббингга намоз ўқи ва жонлиқ сўй."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6206.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6206.mp3","juz":30,"page":602,"sajda":false},{"number":6207,"numberInSurah":3,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","translation":{"latin":"Albatta, seni yomon koʻrib ayblovchining oʻzining orqasi kesik.","cyrillic":"Албатта, сени ёмон кўриб айбловчининг ўзининг орқаси кесик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6207.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6207.mp3","juz":30,"page":602,"sajda":false}]}