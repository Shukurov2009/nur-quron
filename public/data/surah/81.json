{"number":81,"nameUz":"Takvir","nameCyr":"Таквир","nameArabic":"التَّكۡوِيرِ","nameEnglish":"At-Takwir","englishNameTranslation":"The Overthrowing","revelation":"Makkiy","ayahCount":29,"ayahs":[{"number":5801,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","translation":{"latin":"Vaqtiki, quyoshni buklab, oʻralsa.","cyrillic":"Вақтики, қуёшни буклаб, ўралса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5801.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5801.mp3","juz":30,"page":586,"sajda":false},{"number":5802,"numberInSurah":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","translation":{"latin":"Va vaqtiki yulduzlar uzilib tushib, sochilib ketsa.","cyrillic":"Ва вақтики юлдузлар узилиб тушиб, сочилиб кетса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5802.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5802.mp3","juz":30,"page":586,"sajda":false},{"number":5803,"numberInSurah":3,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","translation":{"latin":"Va vaqtiki, togʻlar joyidan koʻchirilsa.","cyrillic":"Ва вақтики, тоғлар жойидан кўчирилса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5803.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5803.mp3","juz":30,"page":586,"sajda":false},{"number":5804,"numberInSurah":4,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","translation":{"latin":"Va vaqtiki, homilasiga oʻn oy toʻlgan tuyalar qarovsiz qolsa.","cyrillic":"Ва вақтики, ҳомиласига ўн ой тўлган туялар қаровсиз қолса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5804.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5804.mp3","juz":30,"page":586,"sajda":false},{"number":5805,"numberInSurah":5,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","translation":{"latin":"Va vaqtiki, vahshiy hayvonlar bir joyga toʻplansa.","cyrillic":"Ва вақтики, ваҳший ҳайвонлар бир жойга тўпланса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5805.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5805.mp3","juz":30,"page":586,"sajda":false},{"number":5806,"numberInSurah":6,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","translation":{"latin":"Va vaqtiki, dengizlar alanga olib yonsa.","cyrillic":"Ва вақтики, денгизлар аланга олиб ёнса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5806.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5806.mp3","juz":30,"page":586,"sajda":false},{"number":5807,"numberInSurah":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","translation":{"latin":"Va vaqtiki, nafslar juftlashtirilsa.","cyrillic":"Ва вақтики, нафслар жуфтлаштирилса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5807.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5807.mp3","juz":30,"page":586,"sajda":false},{"number":5808,"numberInSurah":8,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","translation":{"latin":"Va vaqtiki, tiriklay koʻmilgan qizdan soʻralsa.","cyrillic":"Ва вақтики, тириклай кўмилган қиздан сўралса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5808.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5808.mp3","juz":30,"page":586,"sajda":false},{"number":5809,"numberInSurah":9,"text":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","translation":{"latin":"U nima gunoh uchun oʻldirilgan?","cyrillic":"У нима гуноҳ учун ўлдирилган?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5809.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5809.mp3","juz":30,"page":586,"sajda":false},{"number":5810,"numberInSurah":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","translation":{"latin":"Va vaqtiki, sahifalar nashr qilinsa.","cyrillic":"Ва вақтики, саҳифалар нашр қилинса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5810.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5810.mp3","juz":30,"page":586,"sajda":false},{"number":5811,"numberInSurah":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","translation":{"latin":"Va vaqtiki, osmon qoʻporilsa.","cyrillic":"Ва вақтики, осмон қўпорилса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5811.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5811.mp3","juz":30,"page":586,"sajda":false},{"number":5812,"numberInSurah":12,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","translation":{"latin":"Va vaqtiki, jahannam qizdirilsa.","cyrillic":"Ва вақтики, жаҳаннам қиздирилса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5812.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5812.mp3","juz":30,"page":586,"sajda":false},{"number":5813,"numberInSurah":13,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","translation":{"latin":"Va vaqtiki, jannat yaqinlashtirilsa.","cyrillic":"Ва вақтики, жаннат яқинлаштирилса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5813.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5813.mp3","juz":30,"page":586,"sajda":false},{"number":5814,"numberInSurah":14,"text":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","translation":{"latin":"Har bir jon nima hozirlaganini biladir.","cyrillic":"Ҳар бир жон нима ҳозирлаганини биладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5814.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5814.mp3","juz":30,"page":586,"sajda":false},{"number":5815,"numberInSurah":15,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","translation":{"latin":"(Kunduzi) maxfiy boʻluvchi(yulduz)lar bilan qasam.","cyrillic":"(Кундузи) махфий бўлувчи(юлдуз)лар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5815.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5815.mp3","juz":30,"page":586,"sajda":false},{"number":5816,"numberInSurah":16,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","translation":{"latin":"(Kechalari) yuruvchi, berkinuvchi(yulduz)lar bilan qasam.","cyrillic":"(Кечалари) юрувчи, беркинувчи(юлдуз)лар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5816.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5816.mp3","juz":30,"page":586,"sajda":false},{"number":5817,"numberInSurah":17,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","translation":{"latin":"Qorongʻuligi ila kirib kelgan kecha bilan qasam.","cyrillic":"Қоронғулиги ила кириб келган кеча билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5817.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5817.mp3","juz":30,"page":586,"sajda":false},{"number":5818,"numberInSurah":18,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","translation":{"latin":"Nafas olib kirib kelgan tong bilan qasam.","cyrillic":"Нафас олиб кириб келган тонг билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5818.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5818.mp3","juz":30,"page":586,"sajda":false},{"number":5819,"numberInSurah":19,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","translation":{"latin":"Albatta u(Qurʼon) karamli elchining soʻzidir.","cyrillic":"Албатта у(Қуръон) карамли элчининг сўзидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5819.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5819.mp3","juz":30,"page":586,"sajda":false},{"number":5820,"numberInSurah":20,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","translation":{"latin":"U quvvatli, arsh Egasi huzurida martabasi oliydir.","cyrillic":"У қувватли, арш Эгаси ҳузурида мартабаси олийдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5820.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5820.mp3","juz":30,"page":586,"sajda":false},{"number":5821,"numberInSurah":21,"text":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","translation":{"latin":"Itoat qilingan, omonatlidir.","cyrillic":"Итоат қилинган, омонатлидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5821.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5821.mp3","juz":30,"page":586,"sajda":false},{"number":5822,"numberInSurah":22,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","translation":{"latin":"Sizning sohibingiz majnun emasdir.","cyrillic":"Сизнинг соҳибингиз мажнун эмасдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5822.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5822.mp3","juz":30,"page":586,"sajda":false},{"number":5823,"numberInSurah":23,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","translation":{"latin":"Batahqiq, ul ani ochiq-oydin ufqda koʻrdi.","cyrillic":"Батаҳқиқ, ул ани очиқ-ойдин уфқда кўрди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5823.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5823.mp3","juz":30,"page":586,"sajda":false},{"number":5824,"numberInSurah":24,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","translation":{"latin":"Va u gʻaybga baxil emasdir.","cyrillic":"Ва у ғайбга бахил эмасдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5824.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5824.mp3","juz":30,"page":586,"sajda":false},{"number":5825,"numberInSurah":25,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","translation":{"latin":"Va u(Qurʼon) toshboʻron qilingan shaytonning soʻzi emasdir.","cyrillic":"Ва у(Қуръон) тошбўрон қилинган шайтоннинг сўзи эмасдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5825.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5825.mp3","juz":30,"page":586,"sajda":false},{"number":5826,"numberInSurah":26,"text":"فَأَيْنَ تَذْهَبُونَ","translation":{"latin":"Bas, qayoqqa ketmoqdasiz?!","cyrillic":"Бас, қаёққа кетмоқдасиз?!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5826.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5826.mp3","juz":30,"page":586,"sajda":false},{"number":5827,"numberInSurah":27,"text":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","translation":{"latin":"U (Qurʼon) olamlarga eslatmadan boshqa narsa emasdir.","cyrillic":"У (Қуръон) оламларга эслатмадан бошқа нарса эмасдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5827.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5827.mp3","juz":30,"page":586,"sajda":false},{"number":5828,"numberInSurah":28,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","translation":{"latin":"Sizlardan istiqomat(toʻgʻri yoʻl)da boʻlishni xohlovchilar uchundir.","cyrillic":"Сизлардан истиқомат(тўғри йўл)да бўлишни хоҳловчилар учундир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5828.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5828.mp3","juz":30,"page":586,"sajda":false},{"number":5829,"numberInSurah":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","translation":{"latin":"Olamlarning Robbi Alloh xohlamasa, sizlar xohlay olmassizlar.","cyrillic":"Оламларнинг Робби Аллоҳ хоҳламаса, сизлар хоҳлай олмассизлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5829.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5829.mp3","juz":30,"page":586,"sajda":false}]}