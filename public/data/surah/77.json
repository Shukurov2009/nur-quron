{"number":77,"nameUz":"Mursalot","nameCyr":"Мурсалот","nameArabic":"المُرۡسَلَاتِ","nameEnglish":"Al-Mursalaat","englishNameTranslation":"The Emissaries","revelation":"Makkiy","ayahCount":50,"ayahs":[{"number":5623,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا","translation":{"latin":"Ket-ket yuborilganlar bilan qasam.","cyrillic":"Кет-кет юборилганлар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5623.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5623.mp3","juz":29,"page":580,"sajda":false},{"number":5624,"numberInSurah":2,"text":"فَٱلْعَٰصِفَٰتِ عَصْفًۭا","translation":{"latin":"Qattiq esgan shamollar bilan qasam.","cyrillic":"Қаттиқ эсган шамоллар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5624.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5624.mp3","juz":29,"page":580,"sajda":false},{"number":5625,"numberInSurah":3,"text":"وَٱلنَّٰشِرَٰتِ نَشْرًۭا","translation":{"latin":"Va (shariatni) nashr qiluvchilar bilan qasam.","cyrillic":"Ва (шариатни) нашр қилувчилар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5625.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5625.mp3","juz":29,"page":580,"sajda":false},{"number":5626,"numberInSurah":4,"text":"فَٱلْفَٰرِقَٰتِ فَرْقًۭا","translation":{"latin":"Farqlovchilar bilan qasam.","cyrillic":"Фарқловчилар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5626.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5626.mp3","juz":29,"page":580,"sajda":false},{"number":5627,"numberInSurah":5,"text":"فَٱلْمُلْقِيَٰتِ ذِكْرًا","translation":{"latin":"Vahiyni tashuvchilar bilan qasam.","cyrillic":"Ваҳийни ташувчилар билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5627.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5627.mp3","juz":29,"page":580,"sajda":false},{"number":5628,"numberInSurah":6,"text":"عُذْرًا أَوْ نُذْرًا","translation":{"latin":"Uzrlarni yoki ogohlantirishlarni ham.","cyrillic":"Узрларни ёки огоҳлантиришларни ҳам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5628.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5628.mp3","juz":29,"page":580,"sajda":false},{"number":5629,"numberInSurah":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ","translation":{"latin":"Albatta, sizga vaʼda qilinayotgan narsa voqeʼ boʻlguvchidir.","cyrillic":"Албатта, сизга ваъда қилинаётган нарса воқеъ бўлгувчидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5629.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5629.mp3","juz":29,"page":580,"sajda":false},{"number":5630,"numberInSurah":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","translation":{"latin":"Bas, vaqtiki yulduzlar oʻchirilsa.","cyrillic":"Бас, вақтики юлдузлар ўчирилса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5630.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5630.mp3","juz":29,"page":580,"sajda":false},{"number":5631,"numberInSurah":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","translation":{"latin":"Va vaqtiki, osmon yorilsa.","cyrillic":"Ва вақтики, осмон ёрилса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5631.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5631.mp3","juz":29,"page":580,"sajda":false},{"number":5632,"numberInSurah":10,"text":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","translation":{"latin":"Va vaqtiki, togʻlar koʻchirilsa.","cyrillic":"Ва вақтики, тоғлар кўчирилса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5632.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5632.mp3","juz":29,"page":580,"sajda":false},{"number":5633,"numberInSurah":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","translation":{"latin":"Va vaqtiki, Paygʻambarlarga vaqt belgilansa.","cyrillic":"Ва вақтики, Пайғамбарларга вақт белгиланса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5633.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5633.mp3","juz":29,"page":580,"sajda":false},{"number":5634,"numberInSurah":12,"text":"لِأَىِّ يَوْمٍ أُجِّلَتْ","translation":{"latin":"Qandoq kunga surilgan-a?","cyrillic":"Қандоқ кунга сурилган-а?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5634.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5634.mp3","juz":29,"page":580,"sajda":false},{"number":5635,"numberInSurah":13,"text":"لِيَوْمِ ٱلْفَصْلِ","translation":{"latin":"Ajratish kuniga.","cyrillic":"Ажратиш кунига."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5635.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5635.mp3","juz":29,"page":580,"sajda":false},{"number":5636,"numberInSurah":14,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","translation":{"latin":"Ajratish kunini senga nima bildirdi?","cyrillic":"Ажратиш кунини сенга нима билдирди?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5636.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5636.mp3","juz":29,"page":580,"sajda":false},{"number":5637,"numberInSurah":15,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":{"latin":"Oʻshal kunda yolgʻonga chiqaruvchilarga vayl boʻlsin!","cyrillic":"Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5637.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5637.mp3","juz":29,"page":580,"sajda":false},{"number":5638,"numberInSurah":16,"text":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","translation":{"latin":"Avvalgilarni halok qilmadikmi?","cyrillic":"Аввалгиларни ҳалок қилмадикми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5638.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5638.mp3","juz":29,"page":580,"sajda":false},{"number":5639,"numberInSurah":17,"text":"ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ","translation":{"latin":"Soʻngra keyingilarini ularga ergashtirmadikmi?","cyrillic":"Сўнгра кейингиларини уларга эргаштирмадикми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5639.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5639.mp3","juz":29,"page":580,"sajda":false},{"number":5640,"numberInSurah":18,"text":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","translation":{"latin":"Gunohkorlarni shundoq qilamiz.","cyrillic":"Гуноҳкорларни шундоқ қиламиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5640.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5640.mp3","juz":29,"page":580,"sajda":false},{"number":5641,"numberInSurah":19,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":{"latin":"Oʻshal kunda yolgʻonga chiqaruvchilarga vayl boʻlsin!","cyrillic":"Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5641.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5641.mp3","juz":29,"page":580,"sajda":false},{"number":5642,"numberInSurah":20,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ","translation":{"latin":"Sizlarni haqir suvdan yaratmadikmi?","cyrillic":"Сизларни ҳақир сувдан яратмадикми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5642.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5642.mp3","juz":29,"page":581,"sajda":false},{"number":5643,"numberInSurah":21,"text":"فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ","translation":{"latin":"Bas, uni mustahkam qarorgohga joylamadikmi?!","cyrillic":"Бас, уни мустаҳкам қароргоҳга жойламадикми?!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5643.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5643.mp3","juz":29,"page":581,"sajda":false},{"number":5644,"numberInSurah":22,"text":"إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ","translation":{"latin":"Maʼlum vaqtgacha.","cyrillic":"Маълум вақтгача."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5644.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5644.mp3","juz":29,"page":581,"sajda":false},{"number":5645,"numberInSurah":23,"text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ","translation":{"latin":"Bas, Biz qodir boʻldik va qandoq ham yaxshi qodir boʻluvchimiz.","cyrillic":"Бас, Биз қодир бўлдик ва қандоқ ҳам яхши қодир бўлувчимиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5645.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5645.mp3","juz":29,"page":581,"sajda":false},{"number":5646,"numberInSurah":24,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":{"latin":"Oʻshal kunda yolgʻonga chiqaruvchilarga vayl boʻlsin!","cyrillic":"Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5646.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5646.mp3","juz":29,"page":581,"sajda":false},{"number":5647,"numberInSurah":25,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","translation":{"latin":"Yerni oʻziga tortuvchi qilib qoʻymadikmi?!","cyrillic":"Ерни ўзига тортувчи қилиб қўймадикми?!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5647.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5647.mp3","juz":29,"page":581,"sajda":false},{"number":5648,"numberInSurah":26,"text":"أَحْيَآءًۭ وَأَمْوَٰتًۭا","translation":{"latin":"Tiriklarni va oʻliklarni.","cyrillic":"Тирикларни ва ўликларни."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5648.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5648.mp3","juz":29,"page":581,"sajda":false},{"number":5649,"numberInSurah":27,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا","translation":{"latin":"Va Biz unda yuksak togʻlar qildik va sizlarni zilol suv bilan sugʻordik.","cyrillic":"Ва Биз унда юксак тоғлар қилдик ва сизларни зилол сув билан суғордик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5649.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5649.mp3","juz":29,"page":581,"sajda":false},{"number":5650,"numberInSurah":28,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":{"latin":"Oʻshal kunda yolgʻonga chiqaruvchilarga vayl boʻlsin!","cyrillic":"Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5650.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5650.mp3","juz":29,"page":581,"sajda":false},{"number":5651,"numberInSurah":29,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","translation":{"latin":"Yuringiz! Oʻzingiz yolgʻonga chiqargan narsaga qarab.","cyrillic":"Юрингиз! Ўзингиз ёлғонга чиқарган нарсага қараб."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5651.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5651.mp3","juz":29,"page":581,"sajda":false},{"number":5652,"numberInSurah":30,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ","translation":{"latin":"Yuringiz! Uch shoʻʼbasi bor «soya»ga qarab.","cyrillic":"Юрингиз! Уч шўъбаси бор «соя»га қараб."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5652.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5652.mp3","juz":29,"page":581,"sajda":false},{"number":5653,"numberInSurah":31,"text":"لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","translation":{"latin":"U, salqin qiluvchimas va olovni ham qaytarmas.","cyrillic":"У, салқин қилувчимас ва оловни ҳам қайтармас."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5653.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5653.mp3","juz":29,"page":581,"sajda":false},{"number":5654,"numberInSurah":32,"text":"إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ","translation":{"latin":"Albatta, u (jahannam) qasrdek uchqunlarni otadir.","cyrillic":"Албатта, у (жаҳаннам) қасрдек учқунларни отадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5654.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5654.mp3","juz":29,"page":581,"sajda":false},{"number":5655,"numberInSurah":33,"text":"كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ","translation":{"latin":"U (uchqun) xuddi qoramtir-sargʻish tuyalarga oʻxshaydir.","cyrillic":"У (учқун) худди қорамтир-сарғиш туяларга ўхшайдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5655.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5655.mp3","juz":29,"page":581,"sajda":false},{"number":5656,"numberInSurah":34,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":{"latin":"Oʻshal kunda yolgʻonga chiqaruvchilarga vayl boʻlsin!","cyrillic":"Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5656.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5656.mp3","juz":29,"page":581,"sajda":false},{"number":5657,"numberInSurah":35,"text":"هَٰذَا يَوْمُ لَا يَنطِقُونَ","translation":{"latin":"Bu, ular gapira olmaydigan kundir.","cyrillic":"Бу, улар гапира олмайдиган кундир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5657.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5657.mp3","juz":29,"page":581,"sajda":false},{"number":5658,"numberInSurah":36,"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","translation":{"latin":"Va ularga uzr aytishga izn berilmaydir.","cyrillic":"Ва уларга узр айтишга изн берилмайдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5658.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5658.mp3","juz":29,"page":581,"sajda":false},{"number":5659,"numberInSurah":37,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":{"latin":"Oʻshal kunda yolgʻonga chiqaruvchilarga vayl boʻlsin!","cyrillic":"Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5659.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5659.mp3","juz":29,"page":581,"sajda":false},{"number":5660,"numberInSurah":38,"text":"هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ","translation":{"latin":"Bu ajratish kuni sizlarni va avvalgilarni jamladik.","cyrillic":"Бу ажратиш куни сизларни ва аввалгиларни жамладик."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5660.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5660.mp3","juz":29,"page":581,"sajda":false},{"number":5661,"numberInSurah":39,"text":"فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ","translation":{"latin":"Bas, sizlarning hiylangiz boʻlsa, Menga ishlatib koʻring-chi?","cyrillic":"Бас, сизларнинг ҳийлангиз бўлса, Менга ишлатиб кўринг-чи?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5661.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5661.mp3","juz":29,"page":581,"sajda":false},{"number":5662,"numberInSurah":40,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":{"latin":"Oʻshal kunda yolgʻonga chiqaruvchilarga vayl boʻlsin!","cyrillic":"Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5662.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5662.mp3","juz":29,"page":581,"sajda":false},{"number":5663,"numberInSurah":41,"text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ","translation":{"latin":"Albatta, taqvodorlar soyalar va buloqlardadir.","cyrillic":"Албатта, тақводорлар соялар ва булоқлардадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5663.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5663.mp3","juz":29,"page":581,"sajda":false},{"number":5664,"numberInSurah":42,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","translation":{"latin":"Va oʻzlari xohlagan mevalardadir.","cyrillic":"Ва ўзлари хоҳлаган мевалардадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5664.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5664.mp3","juz":29,"page":581,"sajda":false},{"number":5665,"numberInSurah":43,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","translation":{"latin":"Yenglar va ichinglar, osh boʻlsin. Qilgan amallaringiz sababidandir.","cyrillic":"Енглар ва ичинглар, ош бўлсин. Қилган амалларингиз сабабидандир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5665.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5665.mp3","juz":29,"page":581,"sajda":false},{"number":5666,"numberInSurah":44,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","translation":{"latin":"Albatta, Biz muhsinlarni shunday mukofotlarmiz.","cyrillic":"Албатта, Биз муҳсинларни шундай мукофотлармиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5666.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5666.mp3","juz":29,"page":581,"sajda":false},{"number":5667,"numberInSurah":45,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":{"latin":"Oʻshal kunda yolgʻonga chiqaruvchilarga vayl boʻlsin!","cyrillic":"Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5667.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5667.mp3","juz":29,"page":581,"sajda":false},{"number":5668,"numberInSurah":46,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","translation":{"latin":"Yenglar va mazza qilinglar, ozginagina. Albatta, sizlar gunohkorsizlar.","cyrillic":"Енглар ва мазза қилинглар, озгинагина. Албатта, сизлар гуноҳкорсизлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5668.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5668.mp3","juz":29,"page":581,"sajda":false},{"number":5669,"numberInSurah":47,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":{"latin":"Oʻshal kunda yolgʻonga chiqaruvchilarga vayl boʻlsin!","cyrillic":"Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5669.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5669.mp3","juz":29,"page":581,"sajda":false},{"number":5670,"numberInSurah":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","translation":{"latin":"Va agar ularga rukuʼ qilinglar deyilsa, rukuʼ qilmaslar.","cyrillic":"Ва агар уларга рукуъ қилинглар дейилса, рукуъ қилмаслар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5670.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5670.mp3","juz":29,"page":581,"sajda":false},{"number":5671,"numberInSurah":49,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":{"latin":"Oʻshal kunda yolgʻonga chiqaruvchilarga vayl boʻlsin!","cyrillic":"Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5671.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5671.mp3","juz":29,"page":581,"sajda":false},{"number":5672,"numberInSurah":50,"text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","translation":{"latin":"Bas, undan keyin qaysi soʻzga ishonadilar?!","cyrillic":"Бас, ундан кейин қайси сўзга ишонадилар?!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5672.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5672.mp3","juz":29,"page":581,"sajda":false}]}