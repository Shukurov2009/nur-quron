{"number":101,"nameUz":"Qori'a","nameCyr":"Қориа","nameArabic":"القَارِعَةِ","nameEnglish":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelation":"Makkiy","ayahCount":11,"ayahs":[{"number":6158,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","translation":{"latin":"Al-Qoriʼa.","cyrillic":"Ал-Қориъа."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6158.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6158.mp3","juz":30,"page":600,"sajda":false},{"number":6159,"numberInSurah":2,"text":"مَا ٱلْقَارِعَةُ","translation":{"latin":"Al-Qoriʼa nima?","cyrillic":"Ал-Қориъа нима?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6159.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6159.mp3","juz":30,"page":600,"sajda":false},{"number":6160,"numberInSurah":3,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","translation":{"latin":"Al-Qoriʼa qandoq narsa ekanligini senga nima bildirdi?","cyrillic":"Ал-Қориъа қандоқ нарса эканлигини сенга нима билдирди?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6160.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6160.mp3","juz":30,"page":600,"sajda":false},{"number":6161,"numberInSurah":4,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","translation":{"latin":"U kunda odamlar toʻzib ketgan kapalakka oʻxshab qolarlar.","cyrillic":"У кунда одамлар тўзиб кетган капалакка ўхшаб қоларлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6161.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6161.mp3","juz":30,"page":600,"sajda":false},{"number":6162,"numberInSurah":5,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","translation":{"latin":"Va togʻlar titilgan junga oʻxshab qolarlar.","cyrillic":"Ва тоғлар титилган жунга ўхшаб қоларлар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6162.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6162.mp3","juz":30,"page":600,"sajda":false},{"number":6163,"numberInSurah":6,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","translation":{"latin":"Kimning tarozusi ogʻir kelsa...","cyrillic":"Кимнинг тарозуси оғир келса..."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6163.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6163.mp3","juz":30,"page":600,"sajda":false},{"number":6164,"numberInSurah":7,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","translation":{"latin":"Bas, u rozilik hayotidadir.","cyrillic":"Бас, у розилик ҳаётидадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6164.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6164.mp3","juz":30,"page":600,"sajda":false},{"number":6165,"numberInSurah":8,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","translation":{"latin":"Va ammo kimning tarozusi engil kelsa...","cyrillic":"Ва аммо кимнинг тарозуси енгил келса..."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6165.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6165.mp3","juz":30,"page":600,"sajda":false},{"number":6166,"numberInSurah":9,"text":"فَأُمُّهُۥ هَاوِيَةٌۭ","translation":{"latin":"Bas, uning onasi haaviya (doʻzax)dir.","cyrillic":"Бас, унинг онаси ҳаавия (дўзах)дир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6166.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6166.mp3","juz":30,"page":600,"sajda":false},{"number":6167,"numberInSurah":10,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","translation":{"latin":"U (Haaviya) qandoq narsa ekanligini senga nima bildirdi?","cyrillic":"У (Ҳаавия) қандоқ нарса эканлигини сенга нима билдирди?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6167.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6167.mp3","juz":30,"page":600,"sajda":false},{"number":6168,"numberInSurah":11,"text":"نَارٌ حَامِيَةٌۢ