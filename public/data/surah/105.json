{"number":105,"nameUz":"Fil","nameCyr":"Фил","nameArabic":"الفِيلِ","nameEnglish":"Al-Fil","englishNameTranslation":"The Elephant","revelation":"Makkiy","ayahCount":5,"ayahs":[{"number":6189,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","translation":{"latin":"Robbing fiyl sohiblarini nima qilganini bilmadingmi?","cyrillic":"Роббинг фийл соҳибларини нима қилганини билмадингми?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6189.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6189.mp3","juz":30,"page":601,"sajda":false},{"number":6190,"numberInSurah":2,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","translation":{"latin":"Ularning makru hiylasini zoye ketkazmadimi?","cyrillic":"Уларнинг макру ҳийласини зое кетказмадими?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6190.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6190.mp3","juz":30,"page":601,"sajda":false},{"number":6191,"numberInSurah":3,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","translation":{"latin":"Va ularning ustiga toʻp-toʻp qushlarni yubormadimi?","cyrillic":"Ва уларнинг устига тўп-тўп қушларни юбормадими?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6191.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6191.mp3","juz":30,"page":601,"sajda":false},{"number":6192,"numberInSurah":4,"text":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","translation":{"latin":"Loydan pishirilgan toshlarni otadigan.","cyrillic":"Лойдан пиширилган тошларни отадиган."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6192.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6192.mp3","juz":30,"page":601,"sajda":false},{"number":6193,"numberInSurah":5,"text":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","translation":{"latin":"Bas, ularni qurt eb tashlagan oʻsimlikka oʻxshatib yubormadimi?","cyrillic":"Б