{"number":1,"nameUz":"Fotiha","nameCyr":"Фотиҳа","nameArabic":"ٱلْفَاتِحَةِ","nameEnglish":"Al-Faatiha","englishNameTranslation":"The Opening","revelation":"Makkiy","ayahCount":7,"ayahs":[{"number":1,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","translation":{"latin":"Mehribon va rahmli Allohning nomi bilan boshlayman.","cyrillic":"Меҳрибон ва раҳмли Аллоҳнинг номи билан бошлайман."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/1.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/1.mp3","juz":1,"page":1,"sajda":false},{"number":2,"numberInSurah":2,"text":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","translation":{"latin":"Hamd olamlarning Robbi — Allohgadir.","cyrillic":"Ҳамд оламларнинг Робби — Аллоҳгадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/2.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/2.mp3","juz":1,"page":1,"sajda":false},{"number":3,"numberInSurah":3,"text":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","translation":{"latin":"U Rohman va Rohiymdir.","cyrillic":"У Роҳман ва Роҳиймдир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/3.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/3.mp3","juz":1,"page":1,"sajda":false},{"number":4,"numberInSurah":4,"text":"مَٰلِكِ يَوْمِ ٱلدِّينِ","translation":{"latin":"Jazo-mukofot kunining Egasidir.","cyrillic":"Жазо-мукофот кунининг Эгасидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/4.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/4.mp3","juz":1,"page":1,"sajda":false},{"number":5,"numberInSurah":5,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","translation":{"latin":"Faqat Sengagina ibodat qilamiz va faqat Sendangina yordam soʻraymiz.","cyrillic":"Фақат Сенгагина ибодат қиламиз ва фақат Сендангина ёрдам сўраймиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5.mp3","juz":1,"page":1,"sajda":false},{"number":6,"numberInSurah":6,"text":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","translation":{"latin":"Bizni toʻgʻri yoʻlga hidoyat qilgin.","cyrillic":"Бизни тўғри йўлга ҳидоят қилгин."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6.mp3","juz":1,"page":1,"sajda":false},{"number":7,"numberInSurah":7,"text":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","translation":{"latin":"Oʻzing neʼmat berganlarning yoʻliga. Gʻazabga qolganlarnikiga ham emas, adashganlarnikiga ham emas.","cyrillic":"Ўзинг неъмат берганларнинг йўлига. Ғазабга қолганларникига ҳам эмас, адашганларникига ҳам эмас."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/7.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/7.mp3","juz":1,"page":1,"sajda":false}]}