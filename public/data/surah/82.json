{"number":82,"nameUz":"Infitor","nameCyr":"Инфитор","nameArabic":"الانفِطَارِ","nameEnglish":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelation":"Makkiy","ayahCount":19,"ayahs":[{"number":5830,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","translation":{"latin":"Vaqtiki, osmon yorilsa.","cyrillic":"Вақтики, осмон ёрилса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5830.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5830.mp3","juz":30,"page":587,"sajda":false},{"number":5831,"numberInSurah":2,"text":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","translation":{"latin":"Va vaqtiki, yulduzlar sochilib ketsa.","cyrillic":"Ва вақтики, юлдузлар сочилиб кетса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5831.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5831.mp3","juz":30,"page":587,"sajda":false},{"number":5832,"numberInSurah":3,"text":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","translation":{"latin":"Va vaqtiki, dengizlar portlatilsa.","cyrillic":"Ва вақтики, денгизлар портлатилса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5832.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5832.mp3","juz":30,"page":587,"sajda":false},{"number":5833,"numberInSurah":4,"text":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","translation":{"latin":"Va vaqtiki, qabrlar ostin-ustin boʻlsa.","cyrillic":"Ва вақтики, қабрлар остин-устин бўлса."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5833.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5833.mp3","juz":30,"page":587,"sajda":false},{"number":5834,"numberInSurah":5,"text":"عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ","translation":{"latin":"Har bir jon — nimani taqdim qildiyu nimani taʼxir qildi — biladir.","cyrillic":"Ҳар бир жон — нимани тақдим қилдию нимани таъхир қилди — биладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5834.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5834.mp3","juz":30,"page":587,"sajda":false},{"number":5835,"numberInSurah":6,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","translation":{"latin":"Ey Inson! Seni nima Karamli Robbing haqida gʻururga ketkazdi?!","cyrillic":"Эй Инсон! Сени нима Карамли Роббинг ҳақида ғурурга кетказди?!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5835.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5835.mp3","juz":30,"page":587,"sajda":false},{"number":5836,"numberInSurah":7,"text":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","translation":{"latin":"U seni toʻla-toʻkis va moʻʼtadil qilib yaratgandi.","cyrillic":"У сени тўла-тўкис ва мўътадил қилиб яратганди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5836.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5836.mp3","juz":30,"page":587,"sajda":false},{"number":5837,"numberInSurah":8,"text":"فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ","translation":{"latin":"Oʻzi xohlagan suvratda seni tarkib qildi.","cyrillic":"Ўзи хоҳлаган сувратда сени таркиб қилди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5837.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5837.mp3","juz":30,"page":587,"sajda":false},{"number":5838,"numberInSurah":9,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","translation":{"latin":"Yoʻq!!! Balki, siz jazoni yolgʻonga chiqarmoqdasiz!!!","cyrillic":"Йўқ!!! Балки, сиз жазони ёлғонга чиқармоқдасиз!!!"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5838.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5838.mp3","juz":30,"page":587,"sajda":false},{"number":5839,"numberInSurah":10,"text":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","translation":{"latin":"Holbuki, sizning ustingizdan kuzatib turuvchilar bordir.","cyrillic":"Ҳолбуки, сизнинг устингиздан кузатиб турувчилар бордир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5839.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5839.mp3","juz":30,"page":587,"sajda":false},{"number":5840,"numberInSurah":11,"text":"كِرَامًۭا كَٰتِبِينَ","translation":{"latin":"Ular hurmatli yozib turguvchilardir.","cyrillic":"Улар ҳурматли ёзиб тургувчилардир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5840.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5840.mp3","juz":30,"page":587,"sajda":false},{"number":5841,"numberInSurah":12,"text":"يَعْلَمُونَ مَا تَفْعَلُونَ","translation":{"latin":"Ular nima qilayotganingizni biladir.","cyrillic":"Улар нима қилаётганингизни биладир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5841.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5841.mp3","juz":30,"page":587,"sajda":false},{"number":5842,"numberInSurah":13,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ","translation":{"latin":"Albatta, yaxshilar jannatdadir.","cyrillic":"Албатта, яхшилар жаннатдадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5842.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5842.mp3","juz":30,"page":587,"sajda":false},{"number":5843,"numberInSurah":14,"text":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ","translation":{"latin":"Va, albatta, fojirlar jahannamdadir.","cyrillic":"Ва, албатта, фожирлар жаҳаннамдадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5843.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5843.mp3","juz":30,"page":587,"sajda":false},{"number":5844,"numberInSurah":15,"text":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","translation":{"latin":"Ular u erga qiyomat kuni kiradir.","cyrillic":"Улар у ерга қиёмат куни кирадир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5844.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5844.mp3","juz":30,"page":587,"sajda":false},{"number":5845,"numberInSurah":16,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","translation":{"latin":"Va ular undan gʻoyib boʻla olmaslar.","cyrillic":"Ва улар ундан ғойиб бўла олмаслар."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5845.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5845.mp3","juz":30,"page":587,"sajda":false},{"number":5846,"numberInSurah":17,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","translation":{"latin":"Va, jazo kuni nima ekanini senga nima bildirdi?","cyrillic":"Ва, жазо куни нима эканини сенга нима билдирди?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5846.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5846.mp3","juz":30,"page":587,"sajda":false},{"number":5847,"numberInSurah":18,"text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","translation":{"latin":"Soʻng, jazo kuni nima ekanini senga nima bildirdi?","cyrillic":"Сўнг, жазо куни нима эканини сенга нима билдирди?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5847.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5847.mp3","juz":30,"page":587,"sajda":false},{"number":5848,"numberInSurah":19,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ","translation":{"latin":"Oʻsha kunda hech bir jon boshqa bir jon uchun biror narsa qilish imkoniga molik emas. U kunda barcha ish Allohning Oʻziga xos.","cyrillic":"Ўша кунда ҳеч бир жон бошқа бир жон учун бирор нарса қилиш имконига молик эмас. У кунда барча иш Аллоҳнинг Ўзига хос."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5848.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5848.mp3","juz":30,"page":587,"sajda":false}]}