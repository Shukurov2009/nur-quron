{"number":93,"nameUz":"Zuho","nameCyr":"Зуҳо","nameArabic":"الضُّحَىٰ","nameEnglish":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","revelation":"Makkiy","ayahCount":11,"ayahs":[{"number":6080,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","translation":{"latin":"Choshtgoh bilan qasam.","cyrillic":"Чоштгоҳ билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6080.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6080.mp3","juz":30,"page":596,"sajda":false},{"number":6081,"numberInSurah":2,"text":"وَٱلَّيْلِ إِذَا سَجَىٰ","translation":{"latin":"Sukunatga choʻmgan tun bilan qasam.","cyrillic":"Сукунатга чўмган тун билан қасам."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6081.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6081.mp3","juz":30,"page":596,"sajda":false},{"number":6082,"numberInSurah":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","translation":{"latin":"Robbing seni tark qilgani yoʻq, senga gʻazab ham qilgani yoʻq.","cyrillic":"Роббинг сени тарк қилгани йўқ, сенга ғазаб ҳам қилгани йўқ."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6082.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6082.mp3","juz":30,"page":596,"sajda":false},{"number":6083,"numberInSurah":4,"text":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","translation":{"latin":"Va albatta, oxirat sen uchun bu dunyodan yaxshidir.","cyrillic":"Ва албатта, охират сен учун бу дунёдан яхшидир."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6083.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6083.mp3","juz":30,"page":596,"sajda":false},{"number":6084,"numberInSurah":5,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","translation":{"latin":"Va tezda Robbing senga ato qilur va sen rozi boʻlursan.","cyrillic":"Ва тезда Роббинг сенга ато қилур ва сен рози бўлурсан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6084.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6084.mp3","juz":30,"page":596,"sajda":false},{"number":6085,"numberInSurah":6,"text":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","translation":{"latin":"U seni etim topib, joylab qoʻymadimi?","cyrillic":"У сени етим топиб, жойлаб қўймадими?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6085.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6085.mp3","juz":30,"page":596,"sajda":false},{"number":6086,"numberInSurah":7,"text":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","translation":{"latin":"Va U seni hayron holda topib, hidoyatga boshlamadimi?","cyrillic":"Ва У сени ҳайрон ҳолда топиб, ҳидоятга бошламадими?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6086.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6086.mp3","juz":30,"page":596,"sajda":false},{"number":6087,"numberInSurah":8,"text":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","translation":{"latin":"Va U seni kambagʻal holda topib, boy qilmadimi?","cyrillic":"Ва У сени камбағал ҳолда топиб, бой қилмадими?"},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6087.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6087.mp3","juz":30,"page":596,"sajda":false},{"number":6088,"numberInSurah":9,"text":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","translation":{"latin":"Ammo etimga qahr qilmagin.","cyrillic":"Аммо етимга қаҳр қилмагин."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6088.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6088.mp3","juz":30,"page":596,"sajda":false},{"number":6089,"numberInSurah":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","translation":{"latin":"Va ammo, «soil»ga zajr qilma.","cyrillic":"Ва аммо, «соил»га зажр қилма."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6089.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6089.mp3","juz":30,"page":596,"sajda":false},{"number":6090,"numberInSurah":11,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","translation":{"latin":"Va ammo Robbingning bergan neʼmati haqida soʻzla.","cyrillic":"Ва аммо Роббингнинг берган неъмати ҳақида сўзла."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6090.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6090.mp3","juz":30,"page":596,"sajda":false}]}