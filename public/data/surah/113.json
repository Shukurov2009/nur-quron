{"number":113,"nameUz":"Falaq","nameCyr":"Фалақ","nameArabic":"الفَلَقِ","nameEnglish":"Al-Falaq","englishNameTranslation":"The Dawn","revelation":"Makkiy","ayahCount":5,"ayahs":[{"number":6226,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","translation":{"latin":"«Tong Robbisidan panoh soʻrayman.","cyrillic":"«Тонг Роббисидан паноҳ сўрайман."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6226.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6226.mp3","juz":30,"page":604,"sajda":false},{"number":6227,"numberInSurah":2,"text":"مِن شَرِّ مَا خَلَقَ","translation":{"latin":"U yaratgan narsalar yomonligidan.","cyrillic":"У яратган нарсалар ёмонлигидан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6227.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6227.mp3","juz":30,"page":604,"sajda":false},{"number":6228,"numberInSurah":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","translation":{"latin":"Va kirib kelgan qorongʻu kechaning yomonligidan.","cyrillic":"Ва кириб келган қоронғу кечанинг ёмонлигидан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6228.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6228.mp3","juz":30,"page":604,"sajda":false},{"number":6229,"numberInSurah":4,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","translation":{"latin":"Va tugunlarga dam soluvchilar yomonligidan.","cyrillic":"Ва тугунларга дам солувчилар ёмонлигидан."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6229.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6229.mp3","juz":30,"page":604,"sajda":false},{"number":6230,"numberInSurah":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","translation":{"latin":"Va hasad qilgan hasadchining yomonligidan», deb ayt.","cyrillic":"Ва ҳасад қилган ҳасадчининг ёмонлигидан», деб айт."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6230.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6230.mp3","juz":30,"page":604,"sajda":false}]}