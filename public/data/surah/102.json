{"number":102,"nameUz":"Takosur","nameCyr":"Такосур","nameArabic":"التَّكَاثُرِ","nameEnglish":"At-Takaathur","englishNameTranslation":"Competition","revelation":"Makkiy","ayahCount":8,"ayahs":[{"number":6169,"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","translation":{"latin":"«Kimniki koʻp» sizni mashgʻul qildi.","cyrillic":"«Кимники кўп» сизни машғул қилди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6169.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6169.mp3","juz":30,"page":600,"sajda":false},{"number":6170,"numberInSurah":2,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","translation":{"latin":"To qabrlarni ziyorat qilguningizcha.","cyrillic":"То қабрларни зиёрат қилгунингизча."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6170.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6170.mp3","juz":30,"page":600,"sajda":false},{"number":6171,"numberInSurah":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","translation":{"latin":"Yoʻq! Sizlar tezda bilasiz.","cyrillic":"Йўқ! Сизлар тезда биласиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6171.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6171.mp3","juz":30,"page":600,"sajda":false},{"number":6172,"numberInSurah":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","translation":{"latin":"Yana yoʻq! Sizlar tezda bilasiz.","cyrillic":"Яна йўқ! Сизлар тезда биласиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6172.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6172.mp3","juz":30,"page":600,"sajda":false},{"number":6173,"numberInSurah":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","translation":{"latin":"Yoʻq! Agar Siz aniq ilm ila bilganingizda edi.","cyrillic":"Йўқ! Агар Сиз аниқ илм ила билганингизда эди."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6173.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6173.mp3","juz":30,"page":600,"sajda":false},{"number":6174,"numberInSurah":6,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","translation":{"latin":"Albatta, jahannamni koʻrasiz.","cyrillic":"Албатта, жаҳаннамни кўрасиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6174.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6174.mp3","juz":30,"page":600,"sajda":false},{"number":6175,"numberInSurah":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","translation":{"latin":"Va yana, albatta, uni ishonch koʻzi bilan koʻrasiz.","cyrillic":"Ва яна, албатта, уни ишонч кўзи билан кўрасиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6175.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6175.mp3","juz":30,"page":600,"sajda":false},{"number":6176,"numberInSurah":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","translation":{"latin":"Soʻngra, oʻsha kunda, albatta, berilgan neʼmatlardan soʻralasiz.","cyrillic":"Сўнгра, ўша кунда, албатта, берилган неъматлардан сўраласиз."},"audio":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6176.mp3","audio64":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6176.mp3","juz":30,"page":600,"sajda":false}]}